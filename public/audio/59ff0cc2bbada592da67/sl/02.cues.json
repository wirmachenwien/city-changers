  "sentenceCues": [
    {
      "sentenceId": "b-f997b8af83d57a21-s1",
      "blockIds": [
        "b-f997b8af83d57a21"
      ],
      "start": 0,
      "end": 3.2,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Poglavje 2: Moč superblokov"
    },
    {
      "sentenceId": "b-74877f55f4597fec-s1",
      "blockIds": [
        "b-74877f55f4597fec"
      ],
      "start": 3.2,
      "end": 12.48,
      "startOffset": 0,
      "endOffset": 131,
      "text": "Superbloki zmanjšujejo tranzitni promet in ustvarjajo prostor za zadrževanje, hojo, kolesarjenje, ozelenitev in sosedsko življenje."
    },
    {
      "sentenceId": "b-74877f55f4597fec-s2",
      "blockIds": [
        "b-74877f55f4597fec"
      ],
      "start": 13.120000000000001,
      "end": 30.8,
      "startOffset": 132,
      "endOffset": 384,
      "text": "Barcelona je koncept uveljavila mednarodno; Berlin je s Kiezblocks razvil različico, ki močno temelji na lokalnih pobudah; Dunaj pa ima primer dobre prakse v projektu Supergrätzl Favoriten in razpravlja tudi o konceptu cenejših »sosesk z malo prometa«."
    },
    {
      "sentenceId": "b-74877f55f4597fec-s3",
      "blockIds": [
        "b-74877f55f4597fec"
      ],
      "start": 31.12,
      "end": 33.88,
      "startOffset": 385,
      "endOffset": 426,
      "text": "Študije potrjujejo koristi za prebivalce."
    },
    {
      "sentenceId": "b-74877f55f4597fec-s4",
      "blockIds": [
        "b-74877f55f4597fec"
      ],
      "start": 34.08,
      "end": 40.88,
      "startOffset": 427,
      "endOffset": 532,
      "text": "Zaradi številnih možnosti oblikovanja so superbloki izvedljivi v večini sosesk in z različnimi proračuni."
    },
    {
      "sentenceId": "b-80c70e4749d12d46-s1",
      "blockIds": [
        "b-80c70e4749d12d46"
      ],
      "start": 40.88,
      "end": 42.32,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Kaj se spremeni"
    },
    {
      "sentenceId": "b-499ad1afacadb06c-s1",
      "blockIds": [
        "b-499ad1afacadb06c"
      ],
      "start": 42.32,
      "end": 47.52,
      "startOffset": 0,
      "endOffset": 70,
      "text": "Superblok ni zgolj posamezen kos urbane opreme ali projekt ozelenitve."
    },
    {
      "sentenceId": "b-499ad1afacadb06c-s2",
      "blockIds": [
        "b-499ad1afacadb06c"
      ],
      "start": 48.08,
      "end": 50.88,
      "startOffset": 71,
      "endOffset": 109,
      "text": "Ključni vzvod je organizacija prometa:"
    },
    {
      "sentenceId": "b-032c820a66991e57-s1",
      "blockIds": [
        "b-032c820a66991e57"
      ],
      "start": 50.88,
      "end": 57.68,
      "startOffset": 0,
      "endOffset": 90,
      "text": "Tranzitni promet preprečujejo modalni filtri, enosmerne ulice, stebrički ali drugi ukrepi."
    },
    {
      "sentenceId": "b-52823014d7a9d6eb-s1",
      "blockIds": [
        "b-52823014d7a9d6eb"
      ],
      "start": 57.68,
      "end": 65.12,
      "startOffset": 0,
      "endOffset": 102,
      "text": "Dostopni in dostavni promet ostajata mogoča, vendar potekata počasneje in pod neposrednejšim nadzorom."
    },
    {
      "sentenceId": "b-e6694886f6782821-s1",
      "blockIds": [
        "b-e6694886f6782821"
      ],
      "start": 65.12,
      "end": 75.28,
      "startOffset": 0,
      "endOffset": 132,
      "text": "Površine znotraj območja se sprostijo za zadrževanje, varne poti v šolo, manjše odprte prostore, drevesa, sedišča in varna križišča."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s1",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 75.28,
      "end": 76.72,
      "startOffset": 0,
      "endOffset": 14,
      "text": "Vidik: Promet."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s2",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 76.96000000000001,
      "end": 82.4,
      "startOffset": 15,
      "endOffset": 86,
      "text": "Logika superbloka: Tranzitni promet se na območju sistematično prekine."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s3",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 82.64,
      "end": 87.64,
      "startOffset": 87,
      "endOffset": 148,
      "text": "Posamezni ukrep: Izboljša se eno križišče, pločnik ali odsek."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s4",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 87.92,
      "end": 90.12,
      "startOffset": 150,
      "endOffset": 177,
      "text": "Vidik: Pridobljeni prostor."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s5",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 90.32,
      "end": 94.52,
      "startOffset": 178,
      "endOffset": 228,
      "text": "Logika superbloka: Več ulic hkrati dobi novo rabo."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s6",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 94.72,
      "end": 99.92,
      "startOffset": 229,
      "endOffset": 297,
      "text": "Posamezni ukrep: En konkreten kraj postane varnejši ali prijetnejši."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s7",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 100.16,
      "end": 102,
      "startOffset": 299,
      "endOffset": 318,
      "text": "Vidik: Sodelovanje."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s8",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 102.24000000000001,
      "end": 108.52000000000001,
      "startOffset": 319,
      "endOffset": 397,
      "text": "Logika superbloka: Soseska, šole, podjetja in četrt potrebujejo skupno vizijo."
    },
    {
      "sentenceId": "b-65f5ff9035c096cd-s9",
      "blockIds": [
        "b-65f5ff9035c096cd"
      ],
      "start": 108.72,
      "end": 113.2,
      "startOffset": 398,
      "endOffset": 460,
      "text": "Posamezni ukrep: Prizadete skupine je mogoče ciljno vključiti."
    },
    {
      "sentenceId": "b-d2ba942d55dd78f0-s1",
      "blockIds": [
        "b-d2ba942d55dd78f0"
      ],
      "start": 113.2,
      "end": 115.44,
      "startOffset": 0,
      "endOffset": 31,
      "text": "Kaj se lahko naučimo od Berlina"
    },
    {
      "sentenceId": "b-3a957a899f754bd2-s1",
      "blockIds": [
        "b-3a957a899f754bd2"
      ],
      "start": 115.44,
      "end": 121.32,
      "startOffset": 0,
      "endOffset": 81,
      "text": "Berlinske pobude Kiezblock kažejo, da na začetku ne potrebujete popolnih načrtov."
    },
    {
      "sentenceId": "b-3a957a899f754bd2-s2",
      "blockIds": [
        "b-3a957a899f754bd2"
      ],
      "start": 121.6,
      "end": 126.96,
      "startOffset": 82,
      "endOffset": 159,
      "text": "Bistveno je, da peščica prebivalcev samoniklo začne pobudo, ki poveže sosede."
    },
    {
      "sentenceId": "b-3a957a899f754bd2-s3",
      "blockIds": [
        "b-3a957a899f754bd2"
      ],
      "start": 127.52,
      "end": 133.12,
      "startOffset": 160,
      "endOffset": 241,
      "text": "Pomembno je povezovanje z lokalnimi zavezniki in krepitev moči od spodaj navzgor."
    },
    {
      "sentenceId": "b-f457ad867bf59f3a-s1",
      "blockIds": [
        "b-f457ad867bf59f3a"
      ],
      "start": 133.12,
      "end": 142.24,
      "startOffset": 0,
      "endOffset": 121,
      "text": "Ne čakajte na dokončan celovit načrt: jasno območje, dokumentiran problem in prvi lokalni zavezniki zadoščajo za začetek."
    },
    {
      "sentenceId": "b-5bd04c6b90cdba86-s1",
      "blockIds": [
        "b-5bd04c6b90cdba86"
      ],
      "start": 142.24,
      "end": 144.08,
      "startOffset": 0,
      "endOffset": 20,
      "text": "Začnite svojo pobudo"
    },
    {
      "sentenceId": "b-b730abf38f49ce71-s1",
      "blockIds": [
        "b-b730abf38f49ce71"
      ],
      "start": 144.08,
      "end": 146.56,
      "startOffset": 0,
      "endOffset": 30,
      "text": "Do superbloka v sedmih korakih"
    },
    {
      "sentenceId": "b-58b25576400c01fa-s1",
      "blockIds": [
        "b-58b25576400c01fa"
      ],
      "start": 146.56,
      "end": 147.12,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Prvič."
    },
    {
      "sentenceId": "b-58b25576400c01fa-s2",
      "blockIds": [
        "b-58b25576400c01fa"
      ],
      "start": 147.32,
      "end": 158.8,
      "startOffset": 7,
      "endOffset": 155,
      "text": "Določite območje: Izberite sosesko, v kateri lahko jasno opredelite tranzitni promet, poti v šolo, vročino, manjkajoča drevesa ali nevarna križišča."
    },
    {
      "sentenceId": "b-58b25576400c01fa-s3",
      "blockIds": [
        "b-58b25576400c01fa"
      ],
      "start": 159.36,
      "end": 163.68,
      "startOffset": 156,
      "endOffset": 217,
      "text": "Dobro je, da vi oziroma vsaj večina vaše skupine v njej biva."
    },
    {
      "sentenceId": "b-645d214f8eed05f9-s1",
      "blockIds": [
        "b-645d214f8eed05f9"
      ],
      "start": 163.68,
      "end": 164.24,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Drugič."
    },
    {
      "sentenceId": "b-645d214f8eed05f9-s2",
      "blockIds": [
        "b-645d214f8eed05f9"
      ],
      "start": 164.48000000000002,
      "end": 171.6,
      "startOffset": 8,
      "endOffset": 97,
      "text": "Dokažite problem: Dokumentirajte opažanja, fotografirajte točke konflikta, štejte promet."
    },
    {
      "sentenceId": "b-ac63058d8acb758e-s1",
      "blockIds": [
        "b-ac63058d8acb758e"
      ],
      "start": 171.6,
      "end": 172.44,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Tretjič."
    },
    {
      "sentenceId": "b-ac63058d8acb758e-s2",
      "blockIds": [
        "b-ac63058d8acb758e"
      ],
      "start": 172.64,
      "end": 183.51999999999998,
      "startOffset": 9,
      "endOffset": 154,
      "text": "Vzpostavite jedrno ekipo: Določite vloge za raziskovanje, stike s sosedi, vodenje družbenih omrežij, stike s četrtno skupnostjo in izvedbo akcij."
    },
    {
      "sentenceId": "b-a1fe360c03e883d1-s1",
      "blockIds": [
        "b-a1fe360c03e883d1"
      ],
      "start": 183.51999999999998,
      "end": 184.23999999999998,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Četrtič."
    },
    {
      "sentenceId": "b-a1fe360c03e883d1-s2",
      "blockIds": [
        "b-a1fe360c03e883d1"
      ],
      "start": 184.88,
      "end": 195.76,
      "startOffset": 9,
      "endOffset": 150,
      "text": "Jasno opredelite cilj: Na primer »brez tranzitnega prometa okoli šole« ali »varne poti in več prostora za zadrževanje v notranjosti soseske«."
    },
    {
      "sentenceId": "b-f9728af3b02b7879-s1",
      "blockIds": [
        "b-f9728af3b02b7879"
      ],
      "start": 195.76,
      "end": 196.51999999999998,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Petič."
    },
    {
      "sentenceId": "b-f9728af3b02b7879-s2",
      "blockIds": [
        "b-f9728af3b02b7879"
      ],
      "start": 196.72,
      "end": 207.2,
      "startOffset": 7,
      "endOffset": 151,
      "text": "Pripravite prvo skico: Uporabite osnovni zemljevid in preverite, kje bi bili mogoči modalni filtri, enosmerne ulice ali prostori za zadrževanje."
    },
    {
      "sentenceId": "b-a1fd6981f48ef4a6-s1",
      "blockIds": [
        "b-a1fd6981f48ef4a6"
      ],
      "start": 207.2,
      "end": 207.92,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Šestič."
    },
    {
      "sentenceId": "b-a1fd6981f48ef4a6-s2",
      "blockIds": [
        "b-a1fd6981f48ef4a6"
      ],
      "start": 208.39999999999998,
      "end": 216.88,
      "startOffset": 8,
      "endOffset": 112,
      "text": "Gradite zavezništva: Nagovorite stanovalce, starše, šole, lokalna društva, trgovine in četrtne politike."
    },
    {
      "sentenceId": "b-dd87c9871492b15d-s1",
      "blockIds": [
        "b-dd87c9871492b15d"
      ],
      "start": 216.88,
      "end": 217.6,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Sedmič."
    },
    {
      "sentenceId": "b-dd87c9871492b15d-s2",
      "blockIds": [
        "b-dd87c9871492b15d"
      ],
      "start": 218.16,
      "end": 229.44,
      "startOffset": 8,
      "endOffset": 159,
      "text": "Javno predstavite zahtevo: Z akcijami, sodelovanjem z mediji, peticijo, predlogi četrtni skupnosti ali odprtim pismom - glede na politične priložnosti."
    },
    {
      "sentenceId": "b-95f8cdb20671ff1b-s1",
      "blockIds": [
        "b-95f8cdb20671ff1b"
      ],
      "start": 229.44,
      "end": 231.2,
      "startOffset": 0,
      "endOffset": 11,
      "text": "Imam idejo!"
    },
    {
      "sentenceId": "b-20c4375215decd7d-s1",
      "blockIds": [
        "b-20c4375215decd7d"
      ],
      "start": 231.2,
      "end": 238.11999999999998,
      "startOffset": 0,
      "endOffset": 90,
      "text": "Pozitivna gesla so najučinkovitejša, ker spodbujajo domišljijo: »Varnejše ulice za otroke!"
    },
    {
      "sentenceId": "b-20c4375215decd7d-s2",
      "blockIds": [
        "b-20c4375215decd7d"
      ],
      "start": 238.32,
      "end": 239.76,
      "startOffset": 91,
      "endOffset": 108,
      "text": "Več sence poleti!"
    },
    {
      "sentenceId": "b-20c4375215decd7d-s3",
      "blockIds": [
        "b-20c4375215decd7d"
      ],
      "start": 240.07999999999998,
      "end": 242.48,
      "startOffset": 109,
      "endOffset": 142,
      "text": "Prostori za počitek in druženje!«"
    },
    {
      "sentenceId": "b-ecdcfcde61a3aafe-s1",
      "blockIds": [
        "b-ecdcfcde61a3aafe"
      ],
      "start": 242.48,
      "end": 243.76,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Vas zanima več?"
    },
    {
      "sentenceId": "b-ecdcfcde61a3aafe-s2",
      "blockIds": [
        "b-ecdcfcde61a3aafe"
      ],
      "start": 244,
      "end": 250.23999999999998,
      "startOffset": 16,
      "endOffset": 112,
      "text": "Preberite celoten priročnik How to Superblock, ki ga je pripravila organizacija Changing Cities."
    },
    {
      "sentenceId": "b-4249baa46991bd74-s1",
      "blockIds": [
        "b-4249baa46991bd74"
      ],
      "start": 250.23999999999998,
      "end": 252.15999999999997,
      "startOffset": 0,
      "endOffset": 19,
      "text": "Igrive intervencije"
    },
    {
      "sentenceId": "b-9bbe6eed9e1efa76-s1",
      "blockIds": [
        "b-9bbe6eed9e1efa76"
      ],
      "start": 252.15999999999997,
      "end": 256.99999999999994,
      "startOffset": 0,
      "endOffset": 70,
      "text": "Igrive intervencije pokažejo, kako drugače bi lahko uporabljali ulico."
    },
    {
      "sentenceId": "b-9bbe6eed9e1efa76-s2",
      "blockIds": [
        "b-9bbe6eed9e1efa76"
      ],
      "start": 257.28,
      "end": 264.43999999999994,
      "startOffset": 71,
      "endOffset": 180,
      "text": "V primeru pobude za superbloke so odlično orodje za pritegnitev javne pozornosti in povezovanje s skupnostjo."
    },
    {
      "sentenceId": "b-9bbe6eed9e1efa76-s3",
      "blockIds": [
        "b-9bbe6eed9e1efa76"
      ],
      "start": 264.71999999999997,
      "end": 276.64,
      "startOffset": 181,
      "endOffset": 335,
      "text": "Sodelovanje je lahko preprosto: kreda, premična sedišča, igre, začasna ozelenitev, informacijske stojnice, ulični piknik ali vizualizacija s transparenti."
    },
    {
      "sentenceId": "b-97f2ed6b31984602-s1",
      "blockIds": [
        "b-97f2ed6b31984602"
      ],
      "start": 276.64,
      "end": 283.8,
      "startOffset": 0,
      "endOffset": 90,
      "text": "Pomembno je, da akcija ni le zanimiva, temveč jasno izraža zahtevo: Kateri problem pokaže?"
    },
    {
      "sentenceId": "b-97f2ed6b31984602-s2",
      "blockIds": [
        "b-97f2ed6b31984602"
      ],
      "start": 284,
      "end": 285.52,
      "startOffset": 91,
      "endOffset": 115,
      "text": "Katero rešitev predlaga?"
    },
    {
      "sentenceId": "b-97f2ed6b31984602-s3",
      "blockIds": [
        "b-97f2ed6b31984602"
      ],
      "start": 285.91999999999996,
      "end": 287.2,
      "startOffset": 116,
      "endOffset": 131,
      "text": "Kdo naj ukrepa?"
    },
    {
      "sentenceId": "b-e98a5f160378df5c-s1",
      "blockIds": [
        "b-e98a5f160378df5c"
      ],
      "start": 287.2,
      "end": 289.68,
      "startOffset": 0,
      "endOffset": 28,
      "text": "Skupaj oblikujte svojo ulico"
    },
    {
      "sentenceId": "b-19d5eb253c397797-s1",
      "blockIds": [
        "b-19d5eb253c397797"
      ],
      "start": 289.68,
      "end": 297.84000000000003,
      "startOffset": 0,
      "endOffset": 113,
      "text": "Delavnica oblikovanja ulic vam in vašim sosedom pomaga, da vsakodnevna nezadovoljstva spremenite v skupno vizijo."
    },
    {
      "sentenceId": "b-19d5eb253c397797-s2",
      "blockIds": [
        "b-19d5eb253c397797"
      ],
      "start": 298.32,
      "end": 304.48,
      "startOffset": 114,
      "endOffset": 208,
      "text": "Wir machen Wien uporablja različna orodja za raziskovanje problemov in zamišljanje alternativ."
    },
    {
      "sentenceId": "b-19d5eb253c397797-s3",
      "blockIds": [
        "b-19d5eb253c397797"
      ],
      "start": 304.72,
      "end": 308.48,
      "startOffset": 209,
      "endOffset": 261,
      "text": "Izberite tista, ki ustrezajo vaši skupini in ciljem."
    },
    {
      "sentenceId": "b-5e298273619f04fe-s1",
      "blockIds": [
        "b-5e298273619f04fe"
      ],
      "start": 308.48,
      "end": 309.28000000000003,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Prvič."
    },
    {
      "sentenceId": "b-5e298273619f04fe-s2",
      "blockIds": [
        "b-5e298273619f04fe"
      ],
      "start": 309.52000000000004,
      "end": 311.84000000000003,
      "startOffset": 7,
      "endOffset": 35,
      "text": "Izberite ulico ali križišče."
    },
    {
      "sentenceId": "b-5e298273619f04fe-s3",
      "blockIds": [
        "b-5e298273619f04fe"
      ],
      "start": 312.24,
      "end": 316.40000000000003,
      "startOffset": 36,
      "endOffset": 95,
      "text": "Izberite kraj, ki ga vaša skupina pozna in želi izboljšati."
    },
    {
      "sentenceId": "b-a415be6069b728a5-s1",
      "blockIds": [
        "b-a415be6069b728a5"
      ],
      "start": 316.40000000000003,
      "end": 317.16,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Drugič."
    },
    {
      "sentenceId": "b-a415be6069b728a5-s2",
      "blockIds": [
        "b-a415be6069b728a5"
      ],
      "start": 317.36,
      "end": 318.72,
      "startOffset": 8,
      "endOffset": 25,
      "text": "Zberite probleme."
    },
    {
      "sentenceId": "b-a415be6069b728a5-s3",
      "blockIds": [
        "b-a415be6069b728a5"
      ],
      "start": 318.96000000000004,
      "end": 328.56000000000006,
      "startOffset": 26,
      "endOffset": 152,
      "text": "Kartirajte vročino, hrup, ozke pločnike, težavne prehode, pritisk na parkirišča, konflikte ter pomanjkanje sedišč ali zelenja."
    },
    {
      "sentenceId": "b-a415be6069b728a5-s4",
      "blockIds": [
        "b-a415be6069b728a5"
      ],
      "start": 328.88000000000005,
      "end": 336.88000000000005,
      "startOffset": 153,
      "endOffset": 261,
      "text": "Street Shit Bingo: Na skupnem sprehodu odkrivajte ovire, nevarnosti in presenetljive rabe uličnega prostora."
    },
    {
      "sentenceId": "b-a415be6069b728a5-s5",
      "blockIds": [
        "b-a415be6069b728a5"
      ],
      "start": 337.20000000000005,
      "end": 345.28000000000003,
      "startOffset": 262,
      "endOffset": 377,
      "text": "Leiwande Straßen Radar: S preprostim popisnim listom raziščite kakovost življenja, varnost in potrebo po ukrepanju."
    },
    {
      "sentenceId": "b-1fb37e9bbb04db91-s1",
      "blockIds": [
        "b-1fb37e9bbb04db91"
      ],
      "start": 345.28000000000003,
      "end": 346.00000000000006,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Tretjič."
    },
    {
      "sentenceId": "b-1fb37e9bbb04db91-s2",
      "blockIds": [
        "b-1fb37e9bbb04db91"
      ],
      "start": 346.40000000000003,
      "end": 347.68,
      "startOffset": 9,
      "endOffset": 27,
      "text": "Spoznajte prostor."
    },
    {
      "sentenceId": "b-1fb37e9bbb04db91-s3",
      "blockIds": [
        "b-1fb37e9bbb04db91"
      ],
      "start": 348.08000000000004,
      "end": 352.16,
      "startOffset": 28,
      "endOffset": 79,
      "text": "Izmerite ulico ali njene mere razberite iz načrtov."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s1",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 352.16,
      "end": 352.96000000000004,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Četrtič."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s2",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 353.36,
      "end": 355.20000000000005,
      "startOffset": 9,
      "endOffset": 31,
      "text": "Oblikujte alternative."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s3",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 355.44,
      "end": 360.24,
      "startOffset": 32,
      "endOffset": 97,
      "text": "Zamislite si majhne izboljšave, drzne ideje in dolgoročne ukrepe."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s4",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 360.72,
      "end": 366.44,
      "startOffset": 98,
      "endOffset": 174,
      "text": "Street Design Table: Načrt ulice prilagodite s papirjem, škarjami in pisali."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s5",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 366.64000000000004,
      "end": 372.16,
      "startOffset": 175,
      "endOffset": 255,
      "text": "Razpravljajte o rabah, o tem, koliko prostora bi zahtevale in možnih spremembah."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s6",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 372.40000000000003,
      "end": 381.24,
      "startOffset": 256,
      "endOffset": 380,
      "text": "Street Banner: Na kraju samem pokažite, kako bi lahko širino ulice razdelili med hojo, kolesarjenje, zelenje in zadrževanje."
    },
    {
      "sentenceId": "b-4b924775f76505b5-s7",
      "blockIds": [
        "b-4b924775f76505b5"
      ],
      "start": 381.44000000000005,
      "end": 388.64000000000004,
      "startOffset": 381,
      "endOffset": 481,
      "text": "Tree Love Set: S kostumi ali tablami v obliki dreves pokažite, kje sta potrebni senca in ozelenitev."
    },
    {
      "sentenceId": "b-0818e45ca9c8b550-s1",
      "blockIds": [
        "b-0818e45ca9c8b550"
      ],
      "start": 388.64000000000004,
      "end": 389.36000000000007,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Petič."
    },
    {
      "sentenceId": "b-0818e45ca9c8b550-s2",
      "blockIds": [
        "b-0818e45ca9c8b550"
      ],
      "start": 389.52000000000004,
      "end": 391.48,
      "startOffset": 7,
      "endOffset": 31,
      "text": "Izberite takojšen ukrep."
    },
    {
      "sentenceId": "b-0818e45ca9c8b550-s3",
      "blockIds": [
        "b-0818e45ca9c8b550"
      ],
      "start": 391.68000000000006,
      "end": 395.84000000000003,
      "startOffset": 32,
      "endOffset": 93,
      "text": "Katera začasna intervencija bi najbolje oživila vašo zamisel?"
    },
    {
      "sentenceId": "b-db4b48e056f6d01a-s1",
      "blockIds": [
        "b-db4b48e056f6d01a"
      ],
      "start": 395.84000000000003,
      "end": 396.76000000000005,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Šestič."
    },
    {
      "sentenceId": "b-db4b48e056f6d01a-s2",
      "blockIds": [
        "b-db4b48e056f6d01a"
      ],
      "start": 396.96000000000004,
      "end": 399.36,
      "startOffset": 8,
      "endOffset": 44,
      "text": "Pridobite dovoljenja in zavezništva."
    },
    {
      "sentenceId": "b-db4b48e056f6d01a-s3",
      "blockIds": [
        "b-db4b48e056f6d01a"
      ],
      "start": 399.84000000000003,
      "end": 404.56000000000006,
      "startOffset": 45,
      "endOffset": 113,
      "text": "Ugotovite, katera dovoljenja potrebujete in kdo bi vas lahko podprl."
    },
    {
      "sentenceId": "b-c1f2ce7894e06fe6-s1",
      "blockIds": [
        "b-c1f2ce7894e06fe6"
      ],
      "start": 404.56000000000006,
      "end": 405.2800000000001,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Sedmič."
    },
    {
      "sentenceId": "b-c1f2ce7894e06fe6-s2",
      "blockIds": [
        "b-c1f2ce7894e06fe6"
      ],
      "start": 405.76000000000005,
      "end": 407.44000000000005,
      "startOffset": 8,
      "endOffset": 30,
      "text": "Dokumentirajte akcijo."
    },
    {
      "sentenceId": "b-c1f2ce7894e06fe6-s3",
      "blockIds": [
        "b-c1f2ce7894e06fe6"
      ],
      "start": 407.68000000000006,
      "end": 415.20000000000005,
      "startOffset": 31,
      "endOffset": 131,
      "text": "Zberite fotografije, mnenja ljudi, opažanja o uporabi prostora, medijske objave in politične odzive."
    },
    {
      "sentenceId": "b-c1f2ce7894e06fe6-s4",
      "blockIds": [
        "b-c1f2ce7894e06fe6"
      ],
      "start": 415.44000000000005,
      "end": 419.2800000000001,
      "startOffset": 132,
      "endOffset": 193,
      "text": "Kasneje vam lahko pomagajo pri zagovarjanju trajnih sprememb."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s1",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 419.2800000000001,
      "end": 421.2000000000001,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Vprašanje za razmislek."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s2",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 421.5200000000001,
      "end": 424.6400000000001,
      "startOffset": 24,
      "endOffset": 71,
      "text": "Kaj sodi k dobremu začetku pobude za superblok?"
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s3",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 425.2800000000001,
      "end": 427.2800000000001,
      "startOffset": 72,
      "endOffset": 95,
      "text": "Jasno določeno območje."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s4",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 427.5200000000001,
      "end": 429.0800000000001,
      "startOffset": 96,
      "endOffset": 117,
      "text": "Dokumentiran problem."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s5",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 429.2800000000001,
      "end": 432.1600000000001,
      "startOffset": 118,
      "endOffset": 148,
      "text": "Dokončan uradni celovit načrt."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s6",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 432.4000000000001,
      "end": 434.3200000000001,
      "startOffset": 149,
      "endOffset": 172,
      "text": "Prvi lokalni zavezniki."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s7",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 434.6400000000001,
      "end": 436.9200000000001,
      "startOffset": 173,
      "endOffset": 206,
      "text": "Vzemite si trenutek za razmislek."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s8",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 440.2800000000001,
      "end": 443.4400000000001,
      "startOffset": 207,
      "endOffset": 239,
      "text": "Odgovor: Jasno določeno območje."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s9",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 443.6400000000001,
      "end": 445.24000000000007,
      "startOffset": 240,
      "endOffset": 261,
      "text": "Dokumentiran problem."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s10",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 445.4800000000001,
      "end": 447.36000000000007,
      "startOffset": 262,
      "endOffset": 285,
      "text": "Prvi lokalni zavezniki."
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s11",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 447.6400000000001,
      "end": 448.56000000000006,
      "startOffset": 286,
      "endOffset": 295,
      "text": "Pravilno!"
    },
    {
      "sentenceId": "b-5f2005b756fdf59f-s12",
      "blockIds": [
        "b-5f2005b756fdf59f"
      ],
      "start": 448.8400000000001,
      "end": 456.36000000000007,
      "startOffset": 296,
      "endOffset": 396,
      "text": "Jasno območje, dokumentiran problem in zavezniki zadoščajo za začetek – celovit načrt pride pozneje."
    }
  ]
}
