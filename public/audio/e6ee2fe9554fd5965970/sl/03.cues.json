  "sentenceCues": [
    {
      "sentenceId": "b-80f47e49bd67788f-s1",
      "blockIds": [
        "b-80f47e49bd67788f"
      ],
      "start": 0,
      "end": 4.64,
      "startOffset": 0,
      "endOffset": 50,
      "text": "Poglavje 3: Taktični urbanizem in oblikovanje ulic"
    },
    {
      "sentenceId": "b-d6a893456b625b2d-s1",
      "blockIds": [
        "b-d6a893456b625b2d"
      ],
      "start": 4.64,
      "end": 10.239999999999998,
      "startOffset": 0,
      "endOffset": 78,
      "text": "Taktični urbanizem pomeni poceni, običajno površinske posege v mestni prostor."
    },
    {
      "sentenceId": "b-d6a893456b625b2d-s2",
      "blockIds": [
        "b-d6a893456b625b2d"
      ],
      "start": 10.48,
      "end": 17.28,
      "startOffset": 79,
      "endOffset": 184,
      "text": "Pokažejo alternative in lahko postanejo trajni, saj spodbudijo politično ukrepanje za trajno preureditev."
    },
    {
      "sentenceId": "b-d6a893456b625b2d-s3",
      "blockIds": [
        "b-d6a893456b625b2d"
      ],
      "start": 17.759999999999998,
      "end": 24.8,
      "startOffset": 185,
      "endOffset": 288,
      "text": "Spodbujajo pogovore, skupnostim pomagajo preizkušati zamisli in krepijo podporo dolgoročnim spremembam."
    },
    {
      "sentenceId": "b-b951bf7dbcd4ad84-s1",
      "blockIds": [
        "b-b951bf7dbcd4ad84"
      ],
      "start": 24.8,
      "end": 26.32,
      "startOffset": 0,
      "endOffset": 14,
      "text": "Osnovna načela"
    },
    {
      "sentenceId": "b-58edc6e2ea36017b-s1",
      "blockIds": [
        "b-58edc6e2ea36017b"
      ],
      "start": 26.32,
      "end": 31.44,
      "startOffset": 0,
      "endOffset": 74,
      "text": "Taktični urbanizem deluje posebej dobro, kadar je izpolnjenih pet pogojev:"
    },
    {
      "sentenceId": "b-5b7c4192d1262a9a-s1",
      "blockIds": [
        "b-5b7c4192d1262a9a"
      ],
      "start": 31.44,
      "end": 36.08,
      "startOffset": 0,
      "endOffset": 61,
      "text": "Ukrep izhaja iz lokalnega okolja in rešuje konkreten problem."
    },
    {
      "sentenceId": "b-f6b021f539a9710c-s1",
      "blockIds": [
        "b-f6b021f539a9710c"
      ],
      "start": 36.08,
      "end": 39.76,
      "startOffset": 0,
      "endOffset": 51,
      "text": "Izvedljiv je v kratkem času in z majhnim tveganjem."
    },
    {
      "sentenceId": "b-fc3dde60fa51e1bb-s1",
      "blockIds": [
        "b-fc3dde60fa51e1bb"
      ],
      "start": 39.76,
      "end": 43.28,
      "startOffset": 0,
      "endOffset": 46,
      "text": "Z majhnim posegom pokaže dolgoročno spremembo."
    },
    {
      "sentenceId": "b-f5ab23d2230a459f-s1",
      "blockIds": [
        "b-f5ab23d2230a459f"
      ],
      "start": 43.28,
      "end": 48.160000000000004,
      "startOffset": 0,
      "endOffset": 55,
      "text": "Gradi odnose med sosesko, pobudami, upravo in politiko."
    },
    {
      "sentenceId": "b-0422d04c5c9e2a68-s1",
      "blockIds": [
        "b-0422d04c5c9e2a68"
      ],
      "start": 48.160000000000004,
      "end": 55.28,
      "startOffset": 0,
      "endOffset": 90,
      "text": "Ustvarja uporabne izkušnje: Kaj deluje, kaj je treba prilagoditi in kdo uporablja prostor?"
    },
    {
      "sentenceId": "b-312eb1a37ed3e51c-s1",
      "blockIds": [
        "b-312eb1a37ed3e51c"
      ],
      "start": 55.28,
      "end": 57.6,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Preverite pred vsako akcijo"
    },
    {
      "sentenceId": "b-6a7c34863a457caa-s1",
      "blockIds": [
        "b-6a7c34863a457caa"
      ],
      "start": 57.6,
      "end": 64.88,
      "startOffset": 0,
      "endOffset": 103,
      "text": "Ali lahko mimoidoči v eni minuti prepozna, kateri problem akcija pokaže in katero boljšo rabo predlaga?"
    },
    {
      "sentenceId": "b-4013852e8d899c98-s1",
      "blockIds": [
        "b-4013852e8d899c98"
      ],
      "start": 64.88,
      "end": 65.75999999999999,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Orodja"
    },
    {
      "sentenceId": "b-f8060c7caf8b6768-s1",
      "blockIds": [
        "b-f8060c7caf8b6768"
      ],
      "start": 65.75999999999999,
      "end": 70.32,
      "startOffset": 0,
      "endOffset": 66,
      "text": "Orodja taktičnega urbanizma spreminjajo ulico na površinski ravni."
    },
    {
      "sentenceId": "b-f8060c7caf8b6768-s2",
      "blockIds": [
        "b-f8060c7caf8b6768"
      ],
      "start": 70.8,
      "end": 71.91999999999999,
      "startOffset": 67,
      "endOffset": 81,
      "text": "Mednje sodijo:"
    },
    {
      "sentenceId": "b-c55752a45225cd13-s1",
      "blockIds": [
        "b-c55752a45225cd13"
      ],
      "start": 71.91999999999999,
      "end": 77.27999999999999,
      "startOffset": 0,
      "endOffset": 61,
      "text": "Ovire, kot so stebrički, betonski elementi ali sadilni obroči"
    },
    {
      "sentenceId": "b-d980ebbe8fe4711b-s1",
      "blockIds": [
        "b-d980ebbe8fe4711b"
      ],
      "start": 77.27999999999999,
      "end": 79.51999999999998,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Ozelenitev in zasaditve"
    },
    {
      "sentenceId": "b-635b9df4fd9080cd-s1",
      "blockIds": [
        "b-635b9df4fd9080cd"
      ],
      "start": 79.51999999999998,
      "end": 81.03999999999998,
      "startOffset": 0,
      "endOffset": 13,
      "text": "Urbana oprema"
    },
    {
      "sentenceId": "b-36739d1c3642cbee-s1",
      "blockIds": [
        "b-36739d1c3642cbee"
      ],
      "start": 81.03999999999998,
      "end": 83.43999999999998,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Oblikovanje površin z barvo"
    },
    {
      "sentenceId": "b-5a0fc7a73f09f9ba-s1",
      "blockIds": [
        "b-5a0fc7a73f09f9ba"
      ],
      "start": 83.43999999999998,
      "end": 85.83999999999999,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Oznake in signalizacija"
    },
    {
      "sentenceId": "b-5a96e5e6a2ca2139-s1",
      "blockIds": [
        "b-5a96e5e6a2ca2139"
      ],
      "start": 85.83999999999999,
      "end": 86.96,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Dogodki"
    },
    {
      "sentenceId": "b-c915e0e3a0702d64-s1",
      "blockIds": [
        "b-c915e0e3a0702d64"
      ],
      "start": 86.96,
      "end": 99.11999999999999,
      "startOffset": 0,
      "endOffset": 164,
      "text": "Kakovost ni v samem orodju, temveč v ustrezni uporabi: pobarvana površina je dobra le, če spremeni vedenje, olajša orientacijo ali prepričljivo predstavi novo rabo."
    },
    {
      "sentenceId": "b-efbfff99677b41df-s1",
      "blockIds": [
        "b-efbfff99677b41df"
      ],
      "start": 99.11999999999999,
      "end": 103.75999999999999,
      "startOffset": 0,
      "endOffset": 58,
      "text": "Taktični urbanizem v praksi: primera iz Gradca in z Dunaja"
    },
    {
      "sentenceId": "b-96e1204522765c83-s1",
      "blockIds": [
        "b-96e1204522765c83"
      ],
      "start": 103.75999999999999,
      "end": 105.19999999999999,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Praktični potek"
    },
    {
      "sentenceId": "b-37dd8f92bab340cd-s1",
      "blockIds": [
        "b-37dd8f92bab340cd"
      ],
      "start": 105.19999999999999,
      "end": 105.67999999999999,
      "startOffset": 0,
      "endOffset": 2,
      "text": "1."
    },
    {
      "sentenceId": "b-37dd8f92bab340cd-s2",
      "blockIds": [
        "b-37dd8f92bab340cd"
      ],
      "start": 106.07999999999998,
      "end": 108.07999999999998,
      "startOffset": 3,
      "endOffset": 30,
      "text": "Začnite z izkušnjami ljudi."
    },
    {
      "sentenceId": "b-39fbadf31926c397-s1",
      "blockIds": [
        "b-39fbadf31926c397"
      ],
      "start": 108.07999999999998,
      "end": 113.15999999999998,
      "startOffset": 0,
      "endOffset": 57,
      "text": "Vprašajte, kaj naredi ulico prijetno, varno ali uporabno."
    },
    {
      "sentenceId": "b-39fbadf31926c397-s2",
      "blockIds": [
        "b-39fbadf31926c397"
      ],
      "start": 113.43999999999998,
      "end": 123.11999999999998,
      "startOffset": 58,
      "endOffset": 201,
      "text": "Osebni spomini, na primer na ulice, kjer so se ljudje igrali kot otroci, lahko odprejo pogovor o tem, kaj bi javni prostor lahko ponujal danes."
    },
    {
      "sentenceId": "b-d2c5b3a612bc0e6b-s1",
      "blockIds": [
        "b-d2c5b3a612bc0e6b"
      ],
      "start": 123.11999999999998,
      "end": 123.83999999999997,
      "startOffset": 0,
      "endOffset": 2,
      "text": "2."
    },
    {
      "sentenceId": "b-d2c5b3a612bc0e6b-s2",
      "blockIds": [
        "b-d2c5b3a612bc0e6b"
      ],
      "start": 124.07999999999997,
      "end": 127.91999999999997,
      "startOffset": 3,
      "endOffset": 51,
      "text": "Ugotovite, kdo uporablja ulico in kaj potrebuje."
    },
    {
      "sentenceId": "b-53c7cfdde4c005b4-s1",
      "blockIds": [
        "b-53c7cfdde4c005b4"
      ],
      "start": 127.91999999999997,
      "end": 138.31999999999996,
      "startOffset": 0,
      "endOffset": 138,
      "text": "Pomislite na otroke, starejše, uporabnike invalidskih vozičkov, kolesarje, pešce, lokalna podjetja, dostavne službe in bližnje prebivalce."
    },
    {
      "sentenceId": "b-53c7cfdde4c005b4-s2",
      "blockIds": [
        "b-53c7cfdde4c005b4"
      ],
      "start": 138.95999999999998,
      "end": 145.91999999999996,
      "startOffset": 139,
      "endOffset": 243,
      "text": "Tudi drevesa in drugi elementi mestnega okolja imajo posebne potrebe, na primer dovolj prostora za rast."
    },
    {
      "sentenceId": "b-828d18fc92ce9ef8-s1",
      "blockIds": [
        "b-828d18fc92ce9ef8"
      ],
      "start": 145.91999999999996,
      "end": 146.47999999999996,
      "startOffset": 0,
      "endOffset": 2,
      "text": "3."
    },
    {
      "sentenceId": "b-828d18fc92ce9ef8-s2",
      "blockIds": [
        "b-828d18fc92ce9ef8"
      ],
      "start": 146.95999999999995,
      "end": 149.91999999999996,
      "startOffset": 3,
      "endOffset": 36,
      "text": "Skupaj opazujte in ocenite ulico."
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s1",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 149.91999999999996,
      "end": 156.11999999999995,
      "startOffset": 0,
      "endOffset": 85,
      "text": "Preprost pregled ulice ljudem pomaga razpravljati o vprašanjih: Je kje mogoče sedeti?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s2",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 156.31999999999996,
      "end": 157.19999999999996,
      "startOffset": 86,
      "endOffset": 96,
      "text": "Je hrupno?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s3",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 157.43999999999997,
      "end": 159.67999999999995,
      "startOffset": 97,
      "endOffset": 130,
      "text": "Kako preprosto je prečkati ulico?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s4",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 160.15999999999997,
      "end": 163.27999999999997,
      "startOffset": 131,
      "endOffset": 176,
      "text": "Kako je prostor razdeljen med oblike prevoza?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s5",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 163.59999999999997,
      "end": 171.43999999999997,
      "startOffset": 177,
      "endOffset": 295,
      "text": "Leiwande Straßen Radar, ki ga je predstavil Wir machen Wien, je primer orodja za ocenjevanje ulice po več kategorijah."
    },
    {
      "sentenceId": "b-af16828208eb558e-s1",
      "blockIds": [
        "b-af16828208eb558e"
      ],
      "start": 171.43999999999997,
      "end": 172.31999999999996,
      "startOffset": 0,
      "endOffset": 2,
      "text": "4."
    },
    {
      "sentenceId": "b-af16828208eb558e-s2",
      "blockIds": [
        "b-af16828208eb558e"
      ],
      "start": 172.55999999999997,
      "end": 175.35999999999996,
      "startOffset": 3,
      "endOffset": 39,
      "text": "Skupno vizijo naredite oprijemljivo."
    },
    {
      "sentenceId": "b-dffcc7f80230b836-s1",
      "blockIds": [
        "b-dffcc7f80230b836"
      ],
      "start": 175.35999999999996,
      "end": 182.59999999999997,
      "startOffset": 0,
      "endOffset": 99,
      "text": "Maketa ali oblikovalska miza udeležencem omogoča preurejanje ulice in skupno raziskovanje možnosti."
    },
    {
      "sentenceId": "b-dffcc7f80230b836-s2",
      "blockIds": [
        "b-dffcc7f80230b836"
      ],
      "start": 182.87999999999997,
      "end": 194.63999999999996,
      "startOffset": 100,
      "endOffset": 261,
      "text": "Začasna barva, premična sedišča, korita za rastline ali transparenti v naravni velikosti pokažejo, kako bi drugačno ureditev ulice občutili v resničnem prostoru."
    },
    {
      "sentenceId": "b-43982b382e565e22-s1",
      "blockIds": [
        "b-43982b382e565e22"
      ],
      "start": 194.63999999999996,
      "end": 195.11999999999995,
      "startOffset": 0,
      "endOffset": 2,
      "text": "5."
    },
    {
      "sentenceId": "b-43982b382e565e22-s2",
      "blockIds": [
        "b-43982b382e565e22"
      ],
      "start": 195.51999999999995,
      "end": 198.71999999999997,
      "startOffset": 3,
      "endOffset": 42,
      "text": "Preizkusite, prisluhnite in nadaljujte."
    },
    {
      "sentenceId": "b-01a654fbfc71a881-s1",
      "blockIds": [
        "b-01a654fbfc71a881"
      ],
      "start": 198.71999999999997,
      "end": 203.19999999999996,
      "startOffset": 0,
      "endOffset": 64,
      "text": "Z začasno intervencijo zberite odzive prebivalcev in mimoidočih."
    },
    {
      "sentenceId": "b-01a654fbfc71a881-s2",
      "blockIds": [
        "b-01a654fbfc71a881"
      ],
      "start": 203.59999999999997,
      "end": 212.55999999999997,
      "startOffset": 65,
      "endOffset": 192,
      "text": "Delite ugotovitve, pojasnite, kako bodo odzivi vplivali na naslednje korake, ter poskus povežite s pogovori z lokalno oblastjo."
    },
    {
      "sentenceId": "b-733c81b646ac240a-s1",
      "blockIds": [
        "b-733c81b646ac240a"
      ],
      "start": 212.55999999999997,
      "end": 215.35999999999999,
      "startOffset": 0,
      "endOffset": 38,
      "text": "Kaj lahko doseže začasna intervencija?"
    },
    {
      "sentenceId": "b-1b235c695c7b3288-s1",
      "blockIds": [
        "b-1b235c695c7b3288"
      ],
      "start": 215.35999999999999,
      "end": 226.64,
      "startOffset": 0,
      "endOffset": 161,
      "text": "Prostoroževi primeri kažejo, kako lahko preprosti materiali in začasne spremembe ustvarijo nove prostore za sedenje, srečevanje ali preživljanje časa na prostem."
    },
    {
      "sentenceId": "b-1b235c695c7b3288-s2",
      "blockIds": [
        "b-1b235c695c7b3288"
      ],
      "start": 227.2,
      "end": 234.51999999999998,
      "startOffset": 162,
      "endOffset": 261,
      "text": "Pri enem od projektov so ulico s sedišči, barvo in rastlinami preoblikovali v majhen javni prostor."
    },
    {
      "sentenceId": "b-1b235c695c7b3288-s3",
      "blockIds": [
        "b-1b235c695c7b3288"
      ],
      "start": 234.79999999999998,
      "end": 244.71999999999997,
      "startOffset": 262,
      "endOffset": 407,
      "text": "Pri drugem je začasna preureditev v bližini šole zagotovila varnejšo pot in prostor za druženje po pouku, preden so se odločili o trajni rešitvi."
    },
    {
      "sentenceId": "b-2d89d464be5d1d96-s1",
      "blockIds": [
        "b-2d89d464be5d1d96"
      ],
      "start": 244.71999999999997,
      "end": 248.95999999999998,
      "startOffset": 0,
      "endOffset": 57,
      "text": "Ti primeri kažejo tudi, da začasno ni nujno kratkotrajno."
    },
    {
      "sentenceId": "b-2d89d464be5d1d96-s2",
      "blockIds": [
        "b-2d89d464be5d1d96"
      ],
      "start": 249.43999999999997,
      "end": 262.64,
      "startOffset": 58,
      "endOffset": 251,
      "text": "Materiale izberite glede na namen: lahki elementi so lahko primerni za kratek preizkus, pilotni projekt, ki bo morda ostal več let, pa potrebuje trpežne materiale, ki jih je mogoče popravljati."
    },
    {
      "sentenceId": "b-885686530d625896-s1",
      "blockIds": [
        "b-885686530d625896"
      ],
      "start": 262.64,
      "end": 264.8,
      "startOffset": 0,
      "endOffset": 26,
      "text": "Na kaj morate biti pozorni"
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s1",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 264.8,
      "end": 267.92,
      "startOffset": 0,
      "endOffset": 47,
      "text": "Proces je prav tako pomemben kot fizični poseg."
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s2",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 268.40000000000003,
      "end": 276.24,
      "startOffset": 48,
      "endOffset": 168,
      "text": "Če ljudi le prosimo za odziv, nato pa nikoli ne izvedo, kako smo ga uporabili, lahko sodelovanje deluje zgolj navidezno."
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s3",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 276.56,
      "end": 283.76,
      "startOffset": 169,
      "endOffset": 276,
      "text": "Jasno povejte, kaj se lahko spremeni, prizadete ljudi vključite zgodaj in jih obveščajte o razvoju načrtov."
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s4",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 284.24,
      "end": 294,
      "startOffset": 277,
      "endOffset": 412,
      "text": "Taktični urbanizem je najučinkovitejši, ko poskus prinese nova spoznanja – in ko imajo ta jasno pot do trajnih, vključujočih izboljšav."
    }
  ]
}
