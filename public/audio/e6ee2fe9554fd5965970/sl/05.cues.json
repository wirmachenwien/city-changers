  "sentenceCues": [
    {
      "sentenceId": "b-490b3902fff5fb6e-s1",
      "blockIds": [
        "b-490b3902fff5fb6e"
      ],
      "start": 0,
      "end": 5.36,
      "startOffset": 0,
      "endOffset": 57,
      "text": "Poglavje 5: Spremljanje: dokumentiranje in prikaz učinkov"
    },
    {
      "sentenceId": "b-9a6f49620364106c-s1",
      "blockIds": [
        "b-9a6f49620364106c"
      ],
      "start": 5.36,
      "end": 14.96,
      "startOffset": 0,
      "endOffset": 134,
      "text": "Spremljanje pomeni dokumentiranje napredka in učinkov, tako lahko pobudo izboljšujete, o njej komunicirate in politično argumentirate."
    },
    {
      "sentenceId": "b-9a6f49620364106c-s2",
      "blockIds": [
        "b-9a6f49620364106c"
      ],
      "start": 15.440000000000001,
      "end": 19.2,
      "startOffset": 135,
      "endOffset": 193,
      "text": "Ni nujno zapleteno – in zanj ne potrebujete strokovnjakov."
    },
    {
      "sentenceId": "b-9a6f49620364106c-s3",
      "blockIds": [
        "b-9a6f49620364106c"
      ],
      "start": 19.68,
      "end": 30.48,
      "startOffset": 194,
      "endOffset": 336,
      "text": "Samoiniciativno raziskovanje ima svojo vrednost: odločevalcem pokaže, kam naj usmerijo pozornost, in omogoči, da ulico vidijo v drugačni luči."
    },
    {
      "sentenceId": "b-eeb702c5347a2690-s1",
      "blockIds": [
        "b-eeb702c5347a2690"
      ],
      "start": 30.48,
      "end": 33.6,
      "startOffset": 0,
      "endOffset": 42,
      "text": "Podatke povežite s pripovedovanjem zgodbe."
    },
    {
      "sentenceId": "b-1721f9776a484faa-s1",
      "blockIds": [
        "b-1721f9776a484faa"
      ],
      "start": 33.6,
      "end": 36.56,
      "startOffset": 0,
      "endOffset": 37,
      "text": "pravi Zala iz organizacije Prostorož."
    },
    {
      "sentenceId": "b-ce4386153ef9667d-s1",
      "blockIds": [
        "b-ce4386153ef9667d"
      ],
      "start": 36.56,
      "end": 39.120000000000005,
      "startOffset": 0,
      "endOffset": 31,
      "text": "Štirje načini zbiranja podatkov"
    },
    {
      "sentenceId": "b-d8ff1b678d2a5eb4-s1",
      "blockIds": [
        "b-d8ff1b678d2a5eb4"
      ],
      "start": 39.120000000000005,
      "end": 46.24,
      "startOffset": 0,
      "endOffset": 102,
      "text": "Prostorož v Ljubljani združuje različne metode glede na izziv – in glede na ljudi, ki jih želi doseči."
    },
    {
      "sentenceId": "b-34ce45a0d8ddaa22-s1",
      "blockIds": [
        "b-34ce45a0d8ddaa22"
      ],
      "start": 46.24,
      "end": 46.64,
      "startOffset": 0,
      "endOffset": 2,
      "text": "1."
    },
    {
      "sentenceId": "b-34ce45a0d8ddaa22-s2",
      "blockIds": [
        "b-34ce45a0d8ddaa22"
      ],
      "start": 46.72,
      "end": 47.84,
      "startOffset": 3,
      "endOffset": 14,
      "text": "Anketiranje"
    },
    {
      "sentenceId": "b-926640d7c797a6c9-s1",
      "blockIds": [
        "b-926640d7c797a6c9"
      ],
      "start": 47.84,
      "end": 51.88,
      "startOffset": 0,
      "endOffset": 53,
      "text": "Ljudi neposredno vprašajte, kako uporabljajo prostor."
    },
    {
      "sentenceId": "b-926640d7c797a6c9-s2",
      "blockIds": [
        "b-926640d7c797a6c9"
      ],
      "start": 52.160000000000004,
      "end": 62.720000000000006,
      "startOffset": 54,
      "endOffset": 198,
      "text": "Ko je Prostorož obiskovalce Ljubljanskih zdravstvenih domov vprašal, kako so prišli tja, je bil odgovor jasen: 64 % jih ni prišlo z avtomobilom."
    },
    {
      "sentenceId": "b-926640d7c797a6c9-s3",
      "blockIds": [
        "b-926640d7c797a6c9"
      ],
      "start": 63.2,
      "end": 68.4,
      "startOffset": 199,
      "endOffset": 274,
      "text": "Ta ugotovitev je postala izhodišče za razpravo o dostopnosti in mobilnosti."
    },
    {
      "sentenceId": "b-88984809b6dfc917-s1",
      "blockIds": [
        "b-88984809b6dfc917"
      ],
      "start": 68.4,
      "end": 68.80000000000001,
      "startOffset": 0,
      "endOffset": 2,
      "text": "2."
    },
    {
      "sentenceId": "b-88984809b6dfc917-s2",
      "blockIds": [
        "b-88984809b6dfc917"
      ],
      "start": 68.88000000000001,
      "end": 70,
      "startOffset": 3,
      "endOffset": 13,
      "text": "Kartiranje"
    },
    {
      "sentenceId": "b-2906ca8f32d725c4-s1",
      "blockIds": [
        "b-2906ca8f32d725c4"
      ],
      "start": 70,
      "end": 78.28,
      "startOffset": 0,
      "endOffset": 112,
      "text": "Ljudje naj na zemljevidu označijo kraje, kjer je prevroče, prenevarno, preglasno, ali kjer radi preživljajo čas."
    },
    {
      "sentenceId": "b-2906ca8f32d725c4-s2",
      "blockIds": [
        "b-2906ca8f32d725c4"
      ],
      "start": 78.56,
      "end": 83.64,
      "startOffset": 113,
      "endOffset": 180,
      "text": "Brezplačni aplikaciji Canvis in Mapperoni olajšata kartiranje točk."
    },
    {
      "sentenceId": "b-2906ca8f32d725c4-s3",
      "blockIds": [
        "b-2906ca8f32d725c4"
      ],
      "start": 83.92,
      "end": 93.52,
      "startOffset": 181,
      "endOffset": 307,
      "text": "Čas je pomemben: če kartirate mestno vročino, anketo začnite ob dneh, ko je več kot 30 °C, ko ljudje problem najbolj občutijo."
    },
    {
      "sentenceId": "b-b53f9677e664d436-s1",
      "blockIds": [
        "b-b53f9677e664d436"
      ],
      "start": 93.52,
      "end": 94.32,
      "startOffset": 0,
      "endOffset": 2,
      "text": "3."
    },
    {
      "sentenceId": "b-b53f9677e664d436-s2",
      "blockIds": [
        "b-b53f9677e664d436"
      ],
      "start": 94.56,
      "end": 96.56,
      "startOffset": 3,
      "endOffset": 24,
      "text": "Skupni miselni vzorci"
    },
    {
      "sentenceId": "b-929c729eeb28502e-s1",
      "blockIds": [
        "b-929c729eeb28502e"
      ],
      "start": 96.56,
      "end": 102.24000000000001,
      "startOffset": 0,
      "endOffset": 82,
      "text": "Skupno zbiranje zamisli na velikem listu je zabavno in razkrije raznolike poglede."
    },
    {
      "sentenceId": "b-929c729eeb28502e-s2",
      "blockIds": [
        "b-929c729eeb28502e"
      ],
      "start": 102.72,
      "end": 107.36,
      "startOffset": 83,
      "endOffset": 148,
      "text": "Upoštevajte, da je rezultate težje pretvoriti v formalne podatke."
    },
    {
      "sentenceId": "b-7501bbe7320ce287-s1",
      "blockIds": [
        "b-7501bbe7320ce287"
      ],
      "start": 107.36,
      "end": 108,
      "startOffset": 0,
      "endOffset": 2,
      "text": "4."
    },
    {
      "sentenceId": "b-7501bbe7320ce287-s2",
      "blockIds": [
        "b-7501bbe7320ce287"
      ],
      "start": 108.4,
      "end": 111.36,
      "startOffset": 3,
      "endOffset": 39,
      "text": "Povezovanje fizičnega in digitalnega"
    },
    {
      "sentenceId": "b-9148297c5df70c6f-s1",
      "blockIds": [
        "b-9148297c5df70c6f"
      ],
      "start": 111.36,
      "end": 115.24,
      "startOffset": 0,
      "endOffset": 52,
      "text": "Nekaj postavite na ulico in hkrati prosite za odziv."
    },
    {
      "sentenceId": "b-9148297c5df70c6f-s2",
      "blockIds": [
        "b-9148297c5df70c6f"
      ],
      "start": 115.52,
      "end": 123.84,
      "startOffset": 53,
      "endOffset": 173,
      "text": "V Ljubljani so postavili testne klopi, mimoidoči pa so lahko oddali mnenje o njih – intervencija je sama postala anketa."
    },
    {
      "sentenceId": "b-869a8d93871c7a3a-s1",
      "blockIds": [
        "b-869a8d93871c7a3a"
      ],
      "start": 123.84,
      "end": 126.24000000000001,
      "startOffset": 0,
      "endOffset": 29,
      "text": "Opazovanje življenja na ulici"
    },
    {
      "sentenceId": "b-5faec76a5d3b62cd-s1",
      "blockIds": [
        "b-5faec76a5d3b62cd"
      ],
      "start": 126.24000000000001,
      "end": 133.04000000000002,
      "startOffset": 0,
      "endOffset": 90,
      "text": "Štetje in opazovanje pokažeta, kaj se na ulici dejansko dogaja – ne le, kaj ljudje povedo."
    },
    {
      "sentenceId": "b-5988dad789c72a27-s1",
      "blockIds": [
        "b-5988dad789c72a27"
      ],
      "start": 133.04000000000002,
      "end": 134.64000000000001,
      "startOffset": 0,
      "endOffset": 13,
      "text": "Tokovi pešcev"
    },
    {
      "sentenceId": "b-4601d6e576e31b06-s1",
      "blockIds": [
        "b-4601d6e576e31b06"
      ],
      "start": 134.64000000000001,
      "end": 141.44000000000003,
      "startOffset": 0,
      "endOffset": 93,
      "text": "Na prometni ulici so prostovoljci šteli pešce v 15-minutnih intervalih in beležili smer hoje."
    },
    {
      "sentenceId": "b-4601d6e576e31b06-s2",
      "blockIds": [
        "b-4601d6e576e31b06"
      ],
      "start": 142.00000000000003,
      "end": 148,
      "startOffset": 94,
      "endOffset": 178,
      "text": "Kartirali so tudi, kje se ljudje zadržujejo – in ugotavljali kje primanjkuje sedišč."
    },
    {
      "sentenceId": "b-a8587d7d94d0dae8-s1",
      "blockIds": [
        "b-a8587d7d94d0dae8"
      ],
      "start": 148,
      "end": 149.12,
      "startOffset": 0,
      "endOffset": 9,
      "text": "Park Beat"
    },
    {
      "sentenceId": "b-428e41b17409970f-s1",
      "blockIds": [
        "b-428e41b17409970f"
      ],
      "start": 149.12,
      "end": 153.32,
      "startOffset": 0,
      "endOffset": 63,
      "text": "Katera parkirišča okoli mestnega središča so dejansko zasedena?"
    },
    {
      "sentenceId": "b-428e41b17409970f-s2",
      "blockIds": [
        "b-428e41b17409970f"
      ],
      "start": 153.6,
      "end": 162.88,
      "startOffset": 64,
      "endOffset": 204,
      "text": "Opazovanja so pokazala, da so imela nekatera ob konicah več avtomobilov kot označenih parkirnih mest, druga pa so imela proste zmogljivosti."
    },
    {
      "sentenceId": "b-428e41b17409970f-s3",
      "blockIds": [
        "b-428e41b17409970f"
      ],
      "start": 163.20000000000002,
      "end": 171.84,
      "startOffset": 205,
      "endOffset": 337,
      "text": "Primerjava z gospodarsko dejavnostjo bližnjih trgovin pomaga preveriti predpostavko, da je vsako parkirno mesto nujno za poslovanje."
    },
    {
      "sentenceId": "b-88284c5de74204e4-s1",
      "blockIds": [
        "b-88284c5de74204e4"
      ],
      "start": 171.84,
      "end": 173.92000000000002,
      "startOffset": 0,
      "endOffset": 22,
      "text": "Aplikacija Public Life"
    },
    {
      "sentenceId": "b-8b34559d118f2033-s1",
      "blockIds": [
        "b-8b34559d118f2033"
      ],
      "start": 173.92000000000002,
      "end": 183.96,
      "startOffset": 0,
      "endOffset": 127,
      "text": "Brezplačna aplikacija Urban95 Public Life, ki sta jo razvila Gehl in Van Leer Foundation, temelji na Public Life Data Protocol."
    },
    {
      "sentenceId": "b-8b34559d118f2033-s2",
      "blockIds": [
        "b-8b34559d118f2033"
      ],
      "start": 184.24,
      "end": 188.96,
      "startOffset": 128,
      "endOffset": 179,
      "text": "Več preberite v Urban95 Public Life Data Framework."
    },
    {
      "sentenceId": "b-8b34559d118f2033-s3",
      "blockIds": [
        "b-8b34559d118f2033"
      ],
      "start": 189.28000000000003,
      "end": 197.28000000000003,
      "startOffset": 180,
      "endOffset": 289,
      "text": "Načrtujte pet do šest prostovoljcev na ulico in opazovalno obdobje od zgodnjega jutra (ob 5. uri) do polnoči."
    },
    {
      "sentenceId": "b-8b34559d118f2033-s4",
      "blockIds": [
        "b-8b34559d118f2033"
      ],
      "start": 197.52,
      "end": 202.8,
      "startOffset": 290,
      "endOffset": 372,
      "text": "Ne potrebujete veliko dni, za analizo rezultatov pa boste potrebovali preglednice."
    },
    {
      "sentenceId": "b-09231c6fd23917c0-s1",
      "blockIds": [
        "b-09231c6fd23917c0"
      ],
      "start": 202.8,
      "end": 204.32000000000002,
      "startOffset": 0,
      "endOffset": 16,
      "text": "Kaj lahko merimo"
    },
    {
      "sentenceId": "b-7c089f22e97508b9-s1",
      "blockIds": [
        "b-7c089f22e97508b9"
      ],
      "start": 204.32000000000002,
      "end": 210.72000000000003,
      "startOffset": 0,
      "endOffset": 86,
      "text": "Za superbloke, taktični urbanizem in oblikovanje ulic so primerni preprosti kazalniki:"
    },
    {
      "sentenceId": "b-470926f342415145-s1",
      "blockIds": [
        "b-470926f342415145"
      ],
      "start": 210.72000000000003,
      "end": 216.56000000000003,
      "startOffset": 0,
      "endOffset": 67,
      "text": "Obseg prometa: Koliko avtomobilov, koles in pešcev uporablja odsek?"
    },
    {
      "sentenceId": "b-2b465e281b1d8474-s1",
      "blockIds": [
        "b-2b465e281b1d8474"
      ],
      "start": 216.56000000000003,
      "end": 222.56000000000003,
      "startOffset": 0,
      "endOffset": 78,
      "text": "Hitrost in konflikti: Kje se vozi prehitro in kje nastajajo nevarne situacije?"
    },
    {
      "sentenceId": "b-ec98a4113cf90e35-s1",
      "blockIds": [
        "b-ec98a4113cf90e35"
      ],
      "start": 222.56000000000003,
      "end": 230.48000000000002,
      "startOffset": 0,
      "endOffset": 96,
      "text": "Zadrževanje: Ali se ljudje ustavljajo, sedijo, se otroci igrajo, se ljudje na ulici pogovarjajo?"
    },
    {
      "sentenceId": "b-e350b8f8c55973de-s1",
      "blockIds": [
        "b-e350b8f8c55973de"
      ],
      "start": 230.48000000000002,
      "end": 235.04000000000002,
      "startOffset": 0,
      "endOffset": 54,
      "text": "Parkiranje: Katera mesta so dejansko zasedena in kdaj?"
    },
    {
      "sentenceId": "b-b53c02b70a97f4ec-s1",
      "blockIds": [
        "b-b53c02b70a97f4ec"
      ],
      "start": 235.04000000000002,
      "end": 243.76000000000002,
      "startOffset": 0,
      "endOffset": 104,
      "text": "Podnebje in udobje: Je na voljo senca, zelenje, pitna voda in so ljudje izpostavljeni vročini ali hrupu?"
    },
    {
      "sentenceId": "b-9910b4bc4af54da1-s1",
      "blockIds": [
        "b-9910b4bc4af54da1"
      ],
      "start": 243.76000000000002,
      "end": 250.64000000000001,
      "startOffset": 0,
      "endOffset": 83,
      "text": "Podpora: Koliko ljudi se podpiše, pride na srečanja, deli vsebine ali ponudi pomoč?"
    },
    {
      "sentenceId": "b-ec137b90a32b2b0a-s1",
      "blockIds": [
        "b-ec137b90a32b2b0a"
      ],
      "start": 250.64000000000001,
      "end": 257.68,
      "startOffset": 0,
      "endOffset": 87,
      "text": "Politični napredek: Kateri predlogi, pogovori, zaveze ali upravna preverjanja potekajo?"
    },
    {
      "sentenceId": "b-c3defb4319448f44-s1",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 257.68,
      "end": 259.84000000000003,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Kazalnik: Tranzitni promet."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s2",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 260,
      "end": 264.40000000000003,
      "startOffset": 28,
      "endOffset": 83,
      "text": "Preprosta metoda: Štetje v dveh stalnih časovnih oknih."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s3",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 264.64,
      "end": 269,
      "startOffset": 84,
      "endOffset": 141,
      "text": "Dobra oblika rezultata: Številka, fotografija, zemljevid."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s4",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 269.2,
      "end": 271.44,
      "startOffset": 143,
      "endOffset": 167,
      "text": "Kazalnik: Tokovi pešcev."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s5",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 271.6,
      "end": 276.96000000000004,
      "startOffset": 168,
      "endOffset": 242,
      "text": "Preprosta metoda: Štetje v 15-minutnih intervalih, vključno s smerjo hoje."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s6",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 277.36,
      "end": 280.32,
      "startOffset": 243,
      "endOffset": 283,
      "text": "Dobra oblika rezultata: Zemljevid tokov."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s7",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 280.48,
      "end": 283.12,
      "startOffset": 285,
      "endOffset": 316,
      "text": "Kazalnik: Hitrost in konflikti."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s8",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 283.28000000000003,
      "end": 293.44,
      "startOffset": 317,
      "endOffset": 466,
      "text": "Preprosta metoda: Opazovanje in analiza fotografij na stalnih točkah; kjer je mogoče, podatki prikazovalnikov hitrosti in policijske evidence nesreč."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s9",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 293.68,
      "end": 301.52,
      "startOffset": 467,
      "endOffset": 582,
      "text": "Dobra oblika rezultata: Zemljevid konfliktov z mesti prehitre vožnje in nesreč, ključnimi podatki in fotografijami."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s10",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 301.573,
      "end": 304.24,
      "startOffset": 584,
      "endOffset": 615,
      "text": "Kazalnik: Kakovost zadrževanja."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s11",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 304.4,
      "end": 309.52,
      "startOffset": 616,
      "endOffset": 686,
      "text": "Preprosta metoda: Opazovanje na terenu in kartiranje mest zadrževanja."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s12",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 309.56,
      "end": 314.08,
      "startOffset": 687,
      "endOffset": 744,
      "text": "Dobra oblika rezultata: Kratke opombe, izjave, zemljevid."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s13",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 314.13300000000004,
      "end": 315.92,
      "startOffset": 746,
      "endOffset": 767,
      "text": "Kazalnik: Parkiranje."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s14",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 316.08,
      "end": 320.12,
      "startOffset": 768,
      "endOffset": 823,
      "text": "Preprosta metoda: Štetje zasedenosti ob različnih urah."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s15",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 320.32,
      "end": 323.44,
      "startOffset": 824,
      "endOffset": 865,
      "text": "Dobra oblika rezultata: Graf zasedenosti."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s16",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 323.6,
      "end": 326.08000000000004,
      "startOffset": 867,
      "endOffset": 895,
      "text": "Kazalnik: Vročina in udobje."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s17",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 326.24,
      "end": 331.72,
      "startOffset": 896,
      "endOffset": 968,
      "text": "Preprosta metoda: Kartiranje vročih točk, karta senc, fotografske točke."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s18",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 331.92,
      "end": 337.68,
      "startOffset": 969,
      "endOffset": 1052,
      "text": "Dobra oblika rezultata: Toplotni zemljevid, par fotografij pred posegom in po njem."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s19",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 337.84000000000003,
      "end": 339.44,
      "startOffset": 1054,
      "endOffset": 1072,
      "text": "Kazalnik: Podpora."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s20",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 339.68,
      "end": 343.68,
      "startOffset": 1073,
      "endOffset": 1119,
      "text": "Preprosta metoda: Pogovori, podpisi, srečanja."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s21",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 343.76,
      "end": 347.28,
      "startOffset": 1120,
      "endOffset": 1170,
      "text": "Dobra oblika rezultata: Seznam z vlogami in stiki."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s22",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 347.52,
      "end": 349.92,
      "startOffset": 1172,
      "endOffset": 1201,
      "text": "Kazalnik: Politični napredek."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s23",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 350.08000000000004,
      "end": 360.48,
      "startOffset": 1202,
      "endOffset": 1352,
      "text": "Preprosta metoda: Spremljanje dnevnih redov in zapisnikov, predlogov, odgovorov in zavez; beleženje datumov, pristojnih organov in naslednjih korakov."
    },
    {
      "sentenceId": "b-c3defb4319448f44-s24",
      "blockIds": [
        "b-c3defb4319448f44"
      ],
      "start": 360.52,
      "end": 367.92,
      "startOffset": 1353,
      "endOffset": 1463,
      "text": "Dobra oblika rezultata: Časovnica ali sledilna tabela z datumi, stanjem in povezavami do ustreznih dokumentov."
    },
    {
      "sentenceId": "b-dd482276613ecafe-s1",
      "blockIds": [
        "b-dd482276613ecafe"
      ],
      "start": 367.92,
      "end": 370,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Od podatkov do sprememb"
    },
    {
      "sentenceId": "b-11ade2cfc7656544-s1",
      "blockIds": [
        "b-11ade2cfc7656544"
      ],
      "start": 370,
      "end": 372.72,
      "startOffset": 0,
      "endOffset": 35,
      "text": "Sami podatki redko koga prepričajo."
    },
    {
      "sentenceId": "b-11ade2cfc7656544-s2",
      "blockIds": [
        "b-11ade2cfc7656544"
      ],
      "start": 373.2,
      "end": 379.44,
      "startOffset": 36,
      "endOffset": 116,
      "text": "Prostorož povezuje tri korake: aktiviranje, oblikovanje vizije in zagovorništvo."
    },
    {
      "sentenceId": "b-11ade2cfc7656544-s3",
      "blockIds": [
        "b-11ade2cfc7656544"
      ],
      "start": 379.68,
      "end": 384.48,
      "startOffset": 117,
      "endOffset": 191,
      "text": "Ugotovitve postanejo prepričljive, ko jih ljudje lahko vidijo in doživijo."
    },
    {
      "sentenceId": "b-11ade2cfc7656544-s4",
      "blockIds": [
        "b-11ade2cfc7656544"
      ],
      "start": 384.72,
      "end": 405.2,
      "startOffset": 192,
      "endOffset": 482,
      "text": "Vizualizacije, ki se neposredno odzivajo na raziskovalne ugotovitve, povedo več kot tabela številk, začasna akcija pa rezultate naredi oprijemljive: pri eni akciji so stojala za kajake, rdeča streha iz blaga in nekaj zložljivih stolov pet parkirnih mest spremenili v prostor za zadrževanje."
    },
    {
      "sentenceId": "b-ecdad7c29d12eba7-s1",
      "blockIds": [
        "b-ecdad7c29d12eba7"
      ],
      "start": 405.2,
      "end": 407.36,
      "startOffset": 0,
      "endOffset": 25,
      "text": "Štirje nauki iz Ljubljane"
    },
    {
      "sentenceId": "b-c201b7fd75bee196-s1",
      "blockIds": [
        "b-c201b7fd75bee196"
      ],
      "start": 407.36,
      "end": 407.92,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Prvič."
    },
    {
      "sentenceId": "b-c201b7fd75bee196-s2",
      "blockIds": [
        "b-c201b7fd75bee196"
      ],
      "start": 408.16,
      "end": 411.36,
      "startOffset": 7,
      "endOffset": 49,
      "text": "Podatke povežite s pripovedovanjem zgodbe."
    },
    {
      "sentenceId": "b-c201b7fd75bee196-s3",
      "blockIds": [
        "b-c201b7fd75bee196"
      ],
      "start": 411.6,
      "end": 416.88,
      "startOffset": 50,
      "endOffset": 124,
      "text": "Številke postanejo močne, ko so del zgodbe, v kateri se ljudje prepoznajo."
    },
    {
      "sentenceId": "b-6d74beceab15f9d1-s1",
      "blockIds": [
        "b-6d74beceab15f9d1"
      ],
      "start": 416.88,
      "end": 417.68,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Drugič."
    },
    {
      "sentenceId": "b-6d74beceab15f9d1-s2",
      "blockIds": [
        "b-6d74beceab15f9d1"
      ],
      "start": 417.92,
      "end": 421.88,
      "startOffset": 8,
      "endOffset": 62,
      "text": "Povežite fizične intervencije z dolgoročnimi vizijami."
    },
    {
      "sentenceId": "b-6d74beceab15f9d1-s3",
      "blockIds": [
        "b-6d74beceab15f9d1"
      ],
      "start": 422.15999999999997,
      "end": 428,
      "startOffset": 63,
      "endOffset": 129,
      "text": "Začasna akcija pokaže, kaj je mogoče; vizija pojasni, kam to vodi."
    },
    {
      "sentenceId": "b-6e690c4efd6b4cab-s1",
      "blockIds": [
        "b-6e690c4efd6b4cab"
      ],
      "start": 428,
      "end": 428.88,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Tretjič."
    },
    {
      "sentenceId": "b-6e690c4efd6b4cab-s2",
      "blockIds": [
        "b-6e690c4efd6b4cab"
      ],
      "start": 429.12,
      "end": 431.36,
      "startOffset": 9,
      "endOffset": 40,
      "text": "Učite se od »nasprotne strani«."
    },
    {
      "sentenceId": "b-6e690c4efd6b4cab-s3",
      "blockIds": [
        "b-6e690c4efd6b4cab"
      ],
      "start": 431.76,
      "end": 437.84,
      "startOffset": 41,
      "endOffset": 121,
      "text": "Uporabite marketinška orodja: močne podobe, preprosta sporočila, pravi trenutek."
    },
    {
      "sentenceId": "b-d8669b8665e142ce-s1",
      "blockIds": [
        "b-d8669b8665e142ce"
      ],
      "start": 437.84,
      "end": 438.64,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Četrtič."
    },
    {
      "sentenceId": "b-d8669b8665e142ce-s2",
      "blockIds": [
        "b-d8669b8665e142ce"
      ],
      "start": 439.11999999999995,
      "end": 440.64,
      "startOffset": 9,
      "endOffset": 31,
      "text": "Veliko fotografirajte."
    },
    {
      "sentenceId": "b-d8669b8665e142ce-s3",
      "blockIds": [
        "b-d8669b8665e142ce"
      ],
      "start": 441.11999999999995,
      "end": 447.44,
      "startOffset": 32,
      "endOffset": 122,
      "text": "Fotografije boste potrebovali za poročila, družbena omrežja, medije in politične pogovore."
    },
    {
      "sentenceId": "b-62763ce3d55dde95-s1",
      "blockIds": [
        "b-62763ce3d55dde95"
      ],
      "start": 447.44,
      "end": 449.68,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Minimalni načrt spremljanja"
    },
    {
      "sentenceId": "b-b64a30824f0f666e-s1",
      "blockIds": [
        "b-b64a30824f0f666e"
      ],
      "start": 449.68,
      "end": 450.48,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Prvič."
    },
    {
      "sentenceId": "b-b64a30824f0f666e-s2",
      "blockIds": [
        "b-b64a30824f0f666e"
      ],
      "start": 450.72,
      "end": 458.08,
      "startOffset": 7,
      "endOffset": 101,
      "text": "Dokumentirajte izhodiščno stanje: fotografije, zemljevid, kratek opis problema in prvo štetje."
    },
    {
      "sentenceId": "b-9b51626de0a07527-s1",
      "blockIds": [
        "b-9b51626de0a07527"
      ],
      "start": 458.08,
      "end": 458.88,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Drugič."
    },
    {
      "sentenceId": "b-9b51626de0a07527-s2",
      "blockIds": [
        "b-9b51626de0a07527"
      ],
      "start": 459.12,
      "end": 466.88,
      "startOffset": 8,
      "endOffset": 110,
      "text": "Določite ciljno vrednost: na primer manj tranzitnega prometa, več varnih prehodov ali več podpornikov."
    },
    {
      "sentenceId": "b-5629f54eac4a1af3-s1",
      "blockIds": [
        "b-5629f54eac4a1af3"
      ],
      "start": 466.88,
      "end": 467.71999999999997,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Tretjič."
    },
    {
      "sentenceId": "b-5629f54eac4a1af3-s2",
      "blockIds": [
        "b-5629f54eac4a1af3"
      ],
      "start": 467.92,
      "end": 478.71999999999997,
      "startOffset": 9,
      "endOffset": 138,
      "text": "Izberite metodo: anketa, kartiranje, štetje prometa ali pešcev, opazovanje, ulični radar ali fotografije pred posegom in po njem."
    },
    {
      "sentenceId": "b-d3b3d089d16f99c9-s1",
      "blockIds": [
        "b-d3b3d089d16f99c9"
      ],
      "start": 478.71999999999997,
      "end": 479.44,
      "startOffset": 0,
      "endOffset": 8,
      "text": "Četrtič."
    },
    {
      "sentenceId": "b-d3b3d089d16f99c9-s2",
      "blockIds": [
        "b-d3b3d089d16f99c9"
      ],
      "start": 479.52,
      "end": 486.71999999999997,
      "startOffset": 9,
      "endOffset": 89,
      "text": "Izberite pravi trenutek: vročino v vročih dneh, promet ob konici, igro po pouku."
    },
    {
      "sentenceId": "b-8ef80560988b2494-s1",
      "blockIds": [
        "b-8ef80560988b2494"
      ],
      "start": 486.71999999999997,
      "end": 487.52,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Petič."
    },
    {
      "sentenceId": "b-8ef80560988b2494-s2",
      "blockIds": [
        "b-8ef80560988b2494"
      ],
      "start": 487.76,
      "end": 496.15999999999997,
      "startOffset": 7,
      "endOffset": 100,
      "text": "Določite odgovornosti: ena oseba zapisuje podatke, druga izjave in stike, tretja fotografira."
    },
    {
      "sentenceId": "b-515edcc3453c8935-s1",
      "blockIds": [
        "b-515edcc3453c8935"
      ],
      "start": 496.15999999999997,
      "end": 497.08,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Šestič."
    },
    {
      "sentenceId": "b-515edcc3453c8935-s2",
      "blockIds": [
        "b-515edcc3453c8935"
      ],
      "start": 497.28,
      "end": 506.47999999999996,
      "startOffset": 8,
      "endOffset": 123,
      "text": "Predstavite rezultate: Pogosto zadošča ena stran: problem, metoda, najpomembnejše številke, fotografije in zahteva."
    },
    {
      "sentenceId": "b-ed794abdee989017-s1",
      "blockIds": [
        "b-ed794abdee989017"
      ],
      "start": 506.47999999999996,
      "end": 507.43999999999994,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Sedmič."
    },
    {
      "sentenceId": "b-ed794abdee989017-s2",
      "blockIds": [
        "b-ed794abdee989017"
      ],
      "start": 507.67999999999995,
      "end": 514,
      "startOffset": 8,
      "endOffset": 87,
      "text": "Učite se: Kaj je treba prilagoditi pri zahtevi, akciji ali gradnji zavezništev?"
    },
    {
      "sentenceId": "b-d87709538d563847-s1",
      "blockIds": [
        "b-d87709538d563847"
      ],
      "start": 514,
      "end": 515.52,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Začnite z malim"
    },
    {
      "sentenceId": "b-a274429e16ed413f-s1",
      "blockIds": [
        "b-a274429e16ed413f"
      ],
      "start": 515.52,
      "end": 519.04,
      "startOffset": 0,
      "endOffset": 51,
      "text": "Zanesljivo spremljanje ni nujno znanstveno popolno."
    },
    {
      "sentenceId": "b-a274429e16ed413f-s2",
      "blockIds": [
        "b-a274429e16ed413f"
      ],
      "start": 519.52,
      "end": 526.88,
      "startOffset": 52,
      "endOffset": 145,
      "text": "Za začetek pogosto zadošča ponovljiva metoda: isti kraj, isti čas, isto opazovalno vprašanje."
    },
    {
      "sentenceId": "b-0062e85fdad8f442-s1",
      "blockIds": [
        "b-0062e85fdad8f442"
      ],
      "start": 526.88,
      "end": 529.36,
      "startOffset": 0,
      "endOffset": 28,
      "text": "Spremljanje kot mobilizacija"
    },
    {
      "sentenceId": "b-6a75b82ea2e7840d-s1",
      "blockIds": [
        "b-6a75b82ea2e7840d"
      ],
      "start": 529.36,
      "end": 532.16,
      "startOffset": 0,
      "endOffset": 41,
      "text": "Spremljanje je lahko samo po sebi akcija."
    },
    {
      "sentenceId": "b-6a75b82ea2e7840d-s2",
      "blockIds": [
        "b-6a75b82ea2e7840d"
      ],
      "start": 532.64,
      "end": 535.6,
      "startOffset": 42,
      "endOffset": 83,
      "text": "Štetje prometa na ulici spodbuja pogovor."
    },
    {
      "sentenceId": "b-6a75b82ea2e7840d-s3",
      "blockIds": [
        "b-6a75b82ea2e7840d"
      ],
      "start": 535.84,
      "end": 541,
      "startOffset": 84,
      "endOffset": 158,
      "text": "Testne klopi z obrazcem za odziv vabijo mimoidoče, da povedo svoje mnenje."
    },
    {
      "sentenceId": "b-6a75b82ea2e7840d-s4",
      "blockIds": [
        "b-6a75b82ea2e7840d"
      ],
      "start": 541.28,
      "end": 550.48,
      "startOffset": 159,
      "endOffset": 290,
      "text": "Zemljevid vročih ali nevarnih mest lahko pritegne nove podpornike – in vsak, ki sodeluje pri štetju, je lahko nov dejavni zaveznik."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s1",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 550.48,
      "end": 552.4,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Vprašanje za razmislek."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s2",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 552.72,
      "end": 556.28,
      "startOffset": 24,
      "endOffset": 72,
      "text": "V svoji soseski želite kartirati mestno vročino."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s3",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 556.5600000000001,
      "end": 559.12,
      "startOffset": 73,
      "endOffset": 110,
      "text": "Kdaj je najboljši čas za anketiranje?"
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s4",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 559.36,
      "end": 561.76,
      "startOffset": 111,
      "endOffset": 141,
      "text": "Spomladi, ko imajo ljudje čas."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s5",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 562,
      "end": 564.24,
      "startOffset": 142,
      "endOffset": 159,
      "text": "V dneh nad 30 °C."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s6",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 564.8000000000001,
      "end": 566,
      "startOffset": 160,
      "endOffset": 176,
      "text": "Čas ni pomemben."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s7",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 566.5600000000001,
      "end": 568.88,
      "startOffset": 177,
      "endOffset": 210,
      "text": "Vzemite si trenutek za razmislek."
    },
    {
      "sentenceId": "b-4de1b1cfcdd69426-s8",
      "blockIds": [
        "b-4de1b1cfcdd69426"
      ],
      "start": 572.2,
      "end": 575.96,
      "startOffset": 211,
      "endOffset": 237,
      "text": "Odgovor: V dneh nad 30 °C."
    },
    {
      "sentenceId": "b-35343e384ec29b44-s1",
      "blockIds": [
        "b-35343e384ec29b44"
      ],
      "start": 575.96,
      "end": 578.12,
      "startOffset": 0,
      "endOffset": 25,
      "text": "Orodja iz serije delavnic"
    },
    {
      "sentenceId": "b-bf9678b741e0edf1-s1",
      "blockIds": [
        "b-bf9678b741e0edf1"
      ],
      "start": 578.12,
      "end": 582.52,
      "startOffset": 0,
      "endOffset": 55,
      "text": "Ankete in kartiranje vročih točk po pristopu Prostoroža"
    },
    {
      "sentenceId": "b-a0cc162ce6bd9fc3-s1",
      "blockIds": [
        "b-a0cc162ce6bd9fc3"
      ],
      "start": 582.52,
      "end": 587,
      "startOffset": 0,
      "endOffset": 55,
      "text": "Štetje tokov pešcev in opazovanje zasedenosti parkirišč"
    },
    {
      "sentenceId": "b-45c48999aa36a720-s1",
      "blockIds": [
        "b-45c48999aa36a720"
      ],
      "start": 587,
      "end": 591.24,
      "startOffset": 0,
      "endOffset": 55,
      "text": "Aplikacija Public Life za opazovanje življenja na ulici"
    },
    {
      "sentenceId": "b-c8a5a02146023503-s1",
      "blockIds": [
        "b-c8a5a02146023503"
      ],
      "start": 591.24,
      "end": 594.52,
      "startOffset": 0,
      "endOffset": 39,
      "text": "Štetje prometa po vzoru Changing Cities"
    },
    {
      "sentenceId": "b-f38a64392dc61329-s1",
      "blockIds": [
        "b-f38a64392dc61329"
      ],
      "start": 594.52,
      "end": 598.36,
      "startOffset": 0,
      "endOffset": 53,
      "text": "Vodniki za pogovore s podjetniki in lokalnimi akterji"
    },
    {
      "sentenceId": "b-298a5c5da5fb9c73-s1",
      "blockIds": [
        "b-298a5c5da5fb9c73"
      ],
      "start": 598.36,
      "end": 602.04,
      "startOffset": 0,
      "endOffset": 47,
      "text": "Leiwande Straßen Radar za hitro oceno na terenu"
    },
    {
      "sentenceId": "b-55ac1838524b2ab4-s1",
      "blockIds": [
        "b-55ac1838524b2ab4"
      ],
      "start": 602.04,
      "end": 607.56,
      "startOffset": 0,
      "endOffset": 69,
      "text": "Osnovni zemljevid za superbloke in orodje LTN za prostorske scenarije"
    },
    {
      "sentenceId": "b-5511f0c4d56f23a8-s1",
      "blockIds": [
        "b-5511f0c4d56f23a8"
      ],
      "start": 607.56,
      "end": 612.68,
      "startOffset": 0,
      "endOffset": 67,
      "text": "Dokumentiranje stanja pred akcijami taktičnega urbanizma in po njih"
    }
  ]
}
