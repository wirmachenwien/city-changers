  "sentenceCues": [
    {
      "sentenceId": "b-80f47e49bd67788f-s1",
      "blockIds": [
        "b-80f47e49bd67788f"
      ],
      "start": 0,
      "end": 4.64,
      "startOffset": 0,
      "endOffset": 50,
      "text": "Poglavje 3: Taktični urbanizem in oblikovanje ulic"
    },
    {
      "sentenceId": "b-d6a893456b625b2d-s1",
      "blockIds": [
        "b-d6a893456b625b2d"
      ],
      "start": 4.64,
      "end": 11.16,
      "startOffset": 0,
      "endOffset": 88,
      "text": "Taktični urbanizem pomeni poceni, običajno začasne posege na površini mestnega prostora."
    },
    {
      "sentenceId": "b-d6a893456b625b2d-s2",
      "blockIds": [
        "b-d6a893456b625b2d"
      ],
      "start": 11.44,
      "end": 18.68,
      "startOffset": 89,
      "endOffset": 194,
      "text": "Pokažejo alternative in lahko postanejo trajni, saj spodbudijo politično ukrepanje za trajno preureditev."
    },
    {
      "sentenceId": "b-d6a893456b625b2d-s3",
      "blockIds": [
        "b-d6a893456b625b2d"
      ],
      "start": 18.96,
      "end": 26.16,
      "startOffset": 195,
      "endOffset": 298,
      "text": "Spodbujajo pogovore, skupnostim pomagajo preizkušati zamisli in krepijo podporo dolgoročnim spremembam."
    },
    {
      "sentenceId": "b-b951bf7dbcd4ad84-s1",
      "blockIds": [
        "b-b951bf7dbcd4ad84"
      ],
      "start": 26.16,
      "end": 27.68,
      "startOffset": 0,
      "endOffset": 14,
      "text": "Osnovna načela"
    },
    {
      "sentenceId": "b-58edc6e2ea36017b-s1",
      "blockIds": [
        "b-58edc6e2ea36017b"
      ],
      "start": 27.68,
      "end": 32.8,
      "startOffset": 0,
      "endOffset": 74,
      "text": "Taktični urbanizem deluje posebej dobro, kadar je izpolnjenih pet pogojev:"
    },
    {
      "sentenceId": "b-5b7c4192d1262a9a-s1",
      "blockIds": [
        "b-5b7c4192d1262a9a"
      ],
      "start": 32.8,
      "end": 36.879999999999995,
      "startOffset": 0,
      "endOffset": 54,
      "text": "Ukrep je lokalno zasidran in rešuje konkreten problem."
    },
    {
      "sentenceId": "b-f6b021f539a9710c-s1",
      "blockIds": [
        "b-f6b021f539a9710c"
      ],
      "start": 36.879999999999995,
      "end": 40.559999999999995,
      "startOffset": 0,
      "endOffset": 51,
      "text": "Izvedljiv je v kratkem času in z majhnim tveganjem."
    },
    {
      "sentenceId": "b-fc3dde60fa51e1bb-s1",
      "blockIds": [
        "b-fc3dde60fa51e1bb"
      ],
      "start": 40.559999999999995,
      "end": 43.44,
      "startOffset": 0,
      "endOffset": 36,
      "text": "V malem pokaže dolgoročno spremembo."
    },
    {
      "sentenceId": "b-f5ab23d2230a459f-s1",
      "blockIds": [
        "b-f5ab23d2230a459f"
      ],
      "start": 43.44,
      "end": 48.32,
      "startOffset": 0,
      "endOffset": 55,
      "text": "Gradi odnose med sosesko, pobudami, upravo in politiko."
    },
    {
      "sentenceId": "b-0422d04c5c9e2a68-s1",
      "blockIds": [
        "b-0422d04c5c9e2a68"
      ],
      "start": 48.32,
      "end": 55.44,
      "startOffset": 0,
      "endOffset": 90,
      "text": "Ustvarja uporabne izkušnje: Kaj deluje, kaj je treba prilagoditi in kdo uporablja prostor?"
    },
    {
      "sentenceId": "b-312eb1a37ed3e51c-s1",
      "blockIds": [
        "b-312eb1a37ed3e51c"
      ],
      "start": 55.44,
      "end": 57.76,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Preverite pred vsako akcijo"
    },
    {
      "sentenceId": "b-6a7c34863a457caa-s1",
      "blockIds": [
        "b-6a7c34863a457caa"
      ],
      "start": 57.76,
      "end": 65.03999999999999,
      "startOffset": 0,
      "endOffset": 103,
      "text": "Ali lahko mimoidoči v eni minuti prepozna, kateri problem akcija pokaže in katero boljšo rabo predlaga?"
    },
    {
      "sentenceId": "b-4013852e8d899c98-s1",
      "blockIds": [
        "b-4013852e8d899c98"
      ],
      "start": 65.03999999999999,
      "end": 65.91999999999999,
      "startOffset": 0,
      "endOffset": 6,
      "text": "Orodja"
    },
    {
      "sentenceId": "b-f8060c7caf8b6768-s1",
      "blockIds": [
        "b-f8060c7caf8b6768"
      ],
      "start": 65.91999999999999,
      "end": 70.47999999999999,
      "startOffset": 0,
      "endOffset": 66,
      "text": "Orodja taktičnega urbanizma spreminjajo ulico na površinski ravni."
    },
    {
      "sentenceId": "b-f8060c7caf8b6768-s2",
      "blockIds": [
        "b-f8060c7caf8b6768"
      ],
      "start": 70.96,
      "end": 72.07999999999998,
      "startOffset": 67,
      "endOffset": 81,
      "text": "Mednje sodijo:"
    },
    {
      "sentenceId": "b-c55752a45225cd13-s1",
      "blockIds": [
        "b-c55752a45225cd13"
      ],
      "start": 72.07999999999998,
      "end": 77.43999999999998,
      "startOffset": 0,
      "endOffset": 61,
      "text": "Ovire, kot so stebrički, betonski elementi ali sadilni obroči"
    },
    {
      "sentenceId": "b-d980ebbe8fe4711b-s1",
      "blockIds": [
        "b-d980ebbe8fe4711b"
      ],
      "start": 77.43999999999998,
      "end": 79.67999999999998,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Ozelenitev in zasaditve"
    },
    {
      "sentenceId": "b-635b9df4fd9080cd-s1",
      "blockIds": [
        "b-635b9df4fd9080cd"
      ],
      "start": 79.67999999999998,
      "end": 81.19999999999997,
      "startOffset": 0,
      "endOffset": 13,
      "text": "Urbana oprema"
    },
    {
      "sentenceId": "b-36739d1c3642cbee-s1",
      "blockIds": [
        "b-36739d1c3642cbee"
      ],
      "start": 81.19999999999997,
      "end": 83.59999999999998,
      "startOffset": 0,
      "endOffset": 27,
      "text": "Oblikovanje površin z barvo"
    },
    {
      "sentenceId": "b-5a0fc7a73f09f9ba-s1",
      "blockIds": [
        "b-5a0fc7a73f09f9ba"
      ],
      "start": 83.59999999999998,
      "end": 85.99999999999999,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Oznake in signalizacija"
    },
    {
      "sentenceId": "b-5a96e5e6a2ca2139-s1",
      "blockIds": [
        "b-5a96e5e6a2ca2139"
      ],
      "start": 85.99999999999999,
      "end": 87.11999999999999,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Dogodki"
    },
    {
      "sentenceId": "b-c915e0e3a0702d64-s1",
      "blockIds": [
        "b-c915e0e3a0702d64"
      ],
      "start": 87.11999999999999,
      "end": 99.75999999999999,
      "startOffset": 0,
      "endOffset": 166,
      "text": "Kakovost ni v samem predmetu, temveč v ustrezni uporabi: pobarvana površina je dobra le, če spremeni vedenje, olajša orientacijo ali prepričljivo predstavi novo rabo."
    },
    {
      "sentenceId": "b-efbfff99677b41df-s1",
      "blockIds": [
        "b-efbfff99677b41df"
      ],
      "start": 99.75999999999999,
      "end": 104.39999999999999,
      "startOffset": 0,
      "endOffset": 58,
      "text": "Taktični urbanizem v praksi: primera iz Gradca in z Dunaja"
    },
    {
      "sentenceId": "b-96e1204522765c83-s1",
      "blockIds": [
        "b-96e1204522765c83"
      ],
      "start": 104.39999999999999,
      "end": 105.83999999999999,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Praktični potek"
    },
    {
      "sentenceId": "b-37dd8f92bab340cd-s1",
      "blockIds": [
        "b-37dd8f92bab340cd"
      ],
      "start": 105.83999999999999,
      "end": 106.32,
      "startOffset": 0,
      "endOffset": 2,
      "text": "1."
    },
    {
      "sentenceId": "b-37dd8f92bab340cd-s2",
      "blockIds": [
        "b-37dd8f92bab340cd"
      ],
      "start": 106.71999999999998,
      "end": 108.71999999999998,
      "startOffset": 3,
      "endOffset": 30,
      "text": "Začnite z izkušnjami ljudi."
    },
    {
      "sentenceId": "b-39fbadf31926c397-s1",
      "blockIds": [
        "b-39fbadf31926c397"
      ],
      "start": 108.71999999999998,
      "end": 113.79999999999998,
      "startOffset": 0,
      "endOffset": 57,
      "text": "Vprašajte, kaj naredi ulico prijetno, varno ali uporabno."
    },
    {
      "sentenceId": "b-39fbadf31926c397-s2",
      "blockIds": [
        "b-39fbadf31926c397"
      ],
      "start": 114.07999999999998,
      "end": 123.75999999999999,
      "startOffset": 58,
      "endOffset": 201,
      "text": "Osebni spomini, na primer na ulice, kjer so se ljudje igrali kot otroci, lahko odprejo pogovor o tem, kaj bi javni prostor lahko ponujal danes."
    },
    {
      "sentenceId": "b-d2c5b3a612bc0e6b-s1",
      "blockIds": [
        "b-d2c5b3a612bc0e6b"
      ],
      "start": 123.75999999999999,
      "end": 124.47999999999999,
      "startOffset": 0,
      "endOffset": 2,
      "text": "2."
    },
    {
      "sentenceId": "b-d2c5b3a612bc0e6b-s2",
      "blockIds": [
        "b-d2c5b3a612bc0e6b"
      ],
      "start": 124.71999999999998,
      "end": 128.56,
      "startOffset": 3,
      "endOffset": 51,
      "text": "Ugotovite, kdo uporablja ulico in kaj potrebuje."
    },
    {
      "sentenceId": "b-53c7cfdde4c005b4-s1",
      "blockIds": [
        "b-53c7cfdde4c005b4"
      ],
      "start": 128.56,
      "end": 138.96,
      "startOffset": 0,
      "endOffset": 138,
      "text": "Pomislite na otroke, starejše, uporabnike invalidskih vozičkov, kolesarje, pešce, lokalna podjetja, dostavne službe in bližnje prebivalce."
    },
    {
      "sentenceId": "b-53c7cfdde4c005b4-s2",
      "blockIds": [
        "b-53c7cfdde4c005b4"
      ],
      "start": 139.6,
      "end": 146.56,
      "startOffset": 139,
      "endOffset": 243,
      "text": "Tudi drevesa in drugi elementi mestnega okolja imajo posebne potrebe, na primer dovolj prostora za rast."
    },
    {
      "sentenceId": "b-828d18fc92ce9ef8-s1",
      "blockIds": [
        "b-828d18fc92ce9ef8"
      ],
      "start": 146.56,
      "end": 147.12,
      "startOffset": 0,
      "endOffset": 2,
      "text": "3."
    },
    {
      "sentenceId": "b-828d18fc92ce9ef8-s2",
      "blockIds": [
        "b-828d18fc92ce9ef8"
      ],
      "start": 147.6,
      "end": 150.56,
      "startOffset": 3,
      "endOffset": 36,
      "text": "Skupaj opazujte in ocenite ulico."
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s1",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 150.56,
      "end": 156.76,
      "startOffset": 0,
      "endOffset": 85,
      "text": "Preprost pregled ulice ljudem pomaga razpravljati o vprašanjih: Je kje mogoče sedeti?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s2",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 156.96,
      "end": 157.84,
      "startOffset": 86,
      "endOffset": 96,
      "text": "Je hrupno?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s3",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 158.08,
      "end": 160.32,
      "startOffset": 97,
      "endOffset": 130,
      "text": "Kako preprosto je prečkati ulico?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s4",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 160.8,
      "end": 163.92000000000002,
      "startOffset": 131,
      "endOffset": 176,
      "text": "Kako je prostor razdeljen med oblike prevoza?"
    },
    {
      "sentenceId": "b-2a68111e85e31ad2-s5",
      "blockIds": [
        "b-2a68111e85e31ad2"
      ],
      "start": 164.24,
      "end": 172.08,
      "startOffset": 177,
      "endOffset": 295,
      "text": "Leiwande Straßen Radar, ki ga je predstavil Wir machen Wien, je primer orodja za ocenjevanje ulice po več kategorijah."
    },
    {
      "sentenceId": "b-af16828208eb558e-s1",
      "blockIds": [
        "b-af16828208eb558e"
      ],
      "start": 172.08,
      "end": 172.96,
      "startOffset": 0,
      "endOffset": 2,
      "text": "4."
    },
    {
      "sentenceId": "b-af16828208eb558e-s2",
      "blockIds": [
        "b-af16828208eb558e"
      ],
      "start": 173.20000000000002,
      "end": 176,
      "startOffset": 3,
      "endOffset": 39,
      "text": "Skupno vizijo naredite oprijemljivo."
    },
    {
      "sentenceId": "b-dffcc7f80230b836-s1",
      "blockIds": [
        "b-dffcc7f80230b836"
      ],
      "start": 176,
      "end": 183.24,
      "startOffset": 0,
      "endOffset": 99,
      "text": "Maketa ali oblikovalska miza udeležencem omogoča preurejanje ulice in skupno raziskovanje možnosti."
    },
    {
      "sentenceId": "b-dffcc7f80230b836-s2",
      "blockIds": [
        "b-dffcc7f80230b836"
      ],
      "start": 183.52,
      "end": 195.28,
      "startOffset": 100,
      "endOffset": 261,
      "text": "Začasna barva, premična sedišča, korita za rastline ali transparenti v naravni velikosti pokažejo, kako bi drugačno ureditev ulice občutili v resničnem prostoru."
    },
    {
      "sentenceId": "b-43982b382e565e22-s1",
      "blockIds": [
        "b-43982b382e565e22"
      ],
      "start": 195.28,
      "end": 195.76,
      "startOffset": 0,
      "endOffset": 2,
      "text": "5."
    },
    {
      "sentenceId": "b-43982b382e565e22-s2",
      "blockIds": [
        "b-43982b382e565e22"
      ],
      "start": 196.16,
      "end": 199.36,
      "startOffset": 3,
      "endOffset": 42,
      "text": "Preizkusite, prisluhnite in nadaljujte."
    },
    {
      "sentenceId": "b-01a654fbfc71a881-s1",
      "blockIds": [
        "b-01a654fbfc71a881"
      ],
      "start": 199.36,
      "end": 203.84,
      "startOffset": 0,
      "endOffset": 64,
      "text": "Z začasno intervencijo zberite odzive prebivalcev in mimoidočih."
    },
    {
      "sentenceId": "b-01a654fbfc71a881-s2",
      "blockIds": [
        "b-01a654fbfc71a881"
      ],
      "start": 204.24,
      "end": 213.20000000000002,
      "startOffset": 65,
      "endOffset": 192,
      "text": "Delite ugotovitve, pojasnite, kako bodo odzivi vplivali na naslednje korake, ter poskus povežite s pogovori z lokalno oblastjo."
    },
    {
      "sentenceId": "b-733c81b646ac240a-s1",
      "blockIds": [
        "b-733c81b646ac240a"
      ],
      "start": 213.20000000000002,
      "end": 216.00000000000003,
      "startOffset": 0,
      "endOffset": 38,
      "text": "Kaj lahko doseže začasna intervencija?"
    },
    {
      "sentenceId": "b-1b235c695c7b3288-s1",
      "blockIds": [
        "b-1b235c695c7b3288"
      ],
      "start": 216.00000000000003,
      "end": 227.84000000000003,
      "startOffset": 0,
      "endOffset": 172,
      "text": "Primeri Prostoroža iz Ljubljane kažejo, kako lahko preprosti materiali in začasne spremembe ustvarijo nove prostore za sedenje, srečevanje ali preživljanje časa na prostem."
    },
    {
      "sentenceId": "b-1b235c695c7b3288-s2",
      "blockIds": [
        "b-1b235c695c7b3288"
      ],
      "start": 228.48000000000002,
      "end": 235.40000000000003,
      "startOffset": 173,
      "endOffset": 268,
      "text": "Pri enem projektu so ulico s sedišči, barvo in rastlinami preoblikovali v majhen javni prostor."
    },
    {
      "sentenceId": "b-1b235c695c7b3288-s3",
      "blockIds": [
        "b-1b235c695c7b3288"
      ],
      "start": 235.68000000000004,
      "end": 245.68000000000004,
      "startOffset": 269,
      "endOffset": 414,
      "text": "Pri drugem je začasna preureditev v bližini šol zagotovila varnejšo pot in prostor za otroke po pouku, medtem ko so še odločali o trajni rešitvi."
    },
    {
      "sentenceId": "b-2d89d464be5d1d96-s1",
      "blockIds": [
        "b-2d89d464be5d1d96"
      ],
      "start": 245.68000000000004,
      "end": 249.92000000000004,
      "startOffset": 0,
      "endOffset": 57,
      "text": "Ti primeri kažejo tudi, da začasno ni nujno kratkotrajno."
    },
    {
      "sentenceId": "b-2d89d464be5d1d96-s2",
      "blockIds": [
        "b-2d89d464be5d1d96"
      ],
      "start": 250.40000000000003,
      "end": 263.6,
      "startOffset": 58,
      "endOffset": 251,
      "text": "Materiale izberite glede na namen: lahki elementi so lahko primerni za kratek preizkus, pilotni projekt, ki bo morda ostal več let, pa potrebuje trpežne materiale, ki jih je mogoče popravljati."
    },
    {
      "sentenceId": "b-885686530d625896-s1",
      "blockIds": [
        "b-885686530d625896"
      ],
      "start": 263.6,
      "end": 265.76000000000005,
      "startOffset": 0,
      "endOffset": 26,
      "text": "Na kaj morate biti pozorni"
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s1",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 265.76000000000005,
      "end": 268.88000000000005,
      "startOffset": 0,
      "endOffset": 47,
      "text": "Proces je prav tako pomemben kot fizični poseg."
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s2",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 269.36000000000007,
      "end": 277.20000000000005,
      "startOffset": 48,
      "endOffset": 168,
      "text": "Če ljudi le prosimo za odziv, nato pa nikoli ne izvedo, kako smo ga uporabili, lahko sodelovanje deluje zgolj navidezno."
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s3",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 277.52000000000004,
      "end": 284.72,
      "startOffset": 169,
      "endOffset": 276,
      "text": "Jasno povejte, kaj se lahko spremeni, prizadete ljudi vključite zgodaj in jih obveščajte o razvoju načrtov."
    },
    {
      "sentenceId": "b-1b2f02bd808ff672-s4",
      "blockIds": [
        "b-1b2f02bd808ff672"
      ],
      "start": 285.20000000000005,
      "end": 294.96000000000004,
      "startOffset": 277,
      "endOffset": 412,
      "text": "Taktični urbanizem je najučinkovitejši, ko poskus prinese nova spoznanja – in ko imajo ta jasno pot do trajnih, vključujočih izboljšav."
    }
  ]
}
