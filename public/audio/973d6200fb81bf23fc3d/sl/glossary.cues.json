  "sentenceCues": [
    {
      "sentenceId": "b-24b5b92e64a06b10-s1",
      "blockIds": [
        "b-24b5b92e64a06b10"
      ],
      "start": 0,
      "end": 2.4,
      "startOffset": 0,
      "endOffset": 18,
      "text": "Poglavje 7: Slovar"
    },
    {
      "sentenceId": "b-67d1c4322e2db111-s1",
      "blockIds": [
        "b-67d1c4322e2db111"
      ],
      "start": 2.4,
      "end": 7.039999999999999,
      "startOffset": 0,
      "endOffset": 60,
      "text": "Ta slovar po abecedi razlaga ključne pojme iz zbirke orodij."
    },
    {
      "sentenceId": "b-67d1c4322e2db111-s2",
      "blockIds": [
        "b-67d1c4322e2db111"
      ],
      "start": 7.08,
      "end": 11.120000000000001,
      "startOffset": 61,
      "endOffset": 112,
      "text": "Z njim lahko poglavja 1 do 6 bereš brez predznanja."
    },
    {
      "sentenceId": "b-b2eedd04c9bfc9df-s1",
      "blockIds": [
        "b-b2eedd04c9bfc9df"
      ],
      "start": 11.120000000000001,
      "end": 12.000000000000002,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Mejnik."
    },
    {
      "sentenceId": "b-b2eedd04c9bfc9df-s2",
      "blockIds": [
        "b-b2eedd04c9bfc9df"
      ],
      "start": 12.240000000000002,
      "end": 16.48,
      "startOffset": 8,
      "endOffset": 66,
      "text": "Viden vmesni cilj, ki daje kampanji napredek in usmeritev."
    },
    {
      "sentenceId": "b-cd679227b7be440b-s1",
      "blockIds": [
        "b-cd679227b7be440b"
      ],
      "start": 16.48,
      "end": 17.6,
      "startOffset": 0,
      "endOffset": 13,
      "text": "Mobilizacija."
    },
    {
      "sentenceId": "b-cd679227b7be440b-s2",
      "blockIds": [
        "b-cd679227b7be440b"
      ],
      "start": 18.16,
      "end": 24.08,
      "startOffset": 14,
      "endOffset": 100,
      "text": "Delo, s katerim ljudje razumejo, zakaj sodelujejo, in so pripravljeni skupaj ukrepati."
    },
    {
      "sentenceId": "b-20c89d43187447f9-s1",
      "blockIds": [
        "b-20c89d43187447f9"
      ],
      "start": 24.08,
      "end": 25.56,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Modalni filter."
    },
    {
      "sentenceId": "b-20c89d43187447f9-s2",
      "blockIds": [
        "b-20c89d43187447f9"
      ],
      "start": 25.84,
      "end": 37.12,
      "startOffset": 16,
      "endOffset": 166,
      "text": "Ovire, kot so stebrički, korita za rastline ali betonski elementi, ki ustavijo tranzitni promet, dostopnemu in dostavnemu prometu pa omogočijo prehod."
    },
    {
      "sentenceId": "b-314ec563e15adc6d-s1",
      "blockIds": [
        "b-314ec563e15adc6d"
      ],
      "start": 37.12,
      "end": 38.72,
      "startOffset": 0,
      "endOffset": 17,
      "text": "Oblikovanje ulic."
    },
    {
      "sentenceId": "b-314ec563e15adc6d-s2",
      "blockIds": [
        "b-314ec563e15adc6d"
      ],
      "start": 38.96,
      "end": 48.08,
      "startOffset": 18,
      "endOffset": 137,
      "text": "Vključujoče oblikovanje ulic, ki uporablja preprosta orodja, kot so načrt ulice, transparenti ali vizualizacije dreves."
    },
    {
      "sentenceId": "b-3f63fa4268520faa-s1",
      "blockIds": [
        "b-3f63fa4268520faa"
      ],
      "start": 48.08,
      "end": 49.559999999999995,
      "startOffset": 0,
      "endOffset": 17,
      "text": "Okno priložnosti."
    },
    {
      "sentenceId": "b-3f63fa4268520faa-s2",
      "blockIds": [
        "b-3f63fa4268520faa"
      ],
      "start": 49.76,
      "end": 56.56,
      "startOffset": 18,
      "endOffset": 110,
      "text": "Ugodni trenutek za spremembo, na primer volitve, medijska pozornost ali politična odločitev."
    },
    {
      "sentenceId": "b-b01224c7b0c01183-s1",
      "blockIds": [
        "b-b01224c7b0c01183"
      ],
      "start": 56.56,
      "end": 58.24,
      "startOffset": 0,
      "endOffset": 21,
      "text": "Ozaveščanje javnosti."
    },
    {
      "sentenceId": "b-b01224c7b0c01183-s2",
      "blockIds": [
        "b-b01224c7b0c01183"
      ],
      "start": 58.800000000000004,
      "end": 66,
      "startOffset": 22,
      "endOffset": 120,
      "text": "Taktika, s katero temo javno izpostavimo, na primer z akcijo, peticijo ali udarno sliko za medije."
    },
    {
      "sentenceId": "b-9ce43238f4b57cb3-s1",
      "blockIds": [
        "b-9ce43238f4b57cb3"
      ],
      "start": 66,
      "end": 67.04,
      "startOffset": 0,
      "endOffset": 10,
      "text": "Kiezblock."
    },
    {
      "sentenceId": "b-9ce43238f4b57cb3-s2",
      "blockIds": [
        "b-9ce43238f4b57cb3"
      ],
      "start": 67.28,
      "end": 72.32,
      "startOffset": 11,
      "endOffset": 80,
      "text": "Berlinska različica superbloka, ki močno temelji na lokalnih pobudah."
    },
    {
      "sentenceId": "b-78c09cf48e1ca109-s1",
      "blockIds": [
        "b-78c09cf48e1ca109"
      ],
      "start": 72.32,
      "end": 74.08,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Soseska z malo prometa."
    },
    {
      "sentenceId": "b-78c09cf48e1ca109-s2",
      "blockIds": [
        "b-78c09cf48e1ca109"
      ],
      "start": 74.55999999999999,
      "end": 82.16,
      "startOffset": 24,
      "endOffset": 132,
      "text": "Cenejša oblika umirjanja prometa z malo tranzitnega prometa, o kateri razpravljajo kot o dunajski različici."
    },
    {
      "sentenceId": "b-ecd8812bcd4e593b-s1",
      "blockIds": [
        "b-ecd8812bcd4e593b"
      ],
      "start": 82.16,
      "end": 83.32,
      "startOffset": 0,
      "endOffset": 12,
      "text": "Spremljanje."
    },
    {
      "sentenceId": "b-ecd8812bcd4e593b-s2",
      "blockIds": [
        "b-ecd8812bcd4e593b"
      ],
      "start": 83.6,
      "end": 90.47999999999999,
      "startOffset": 13,
      "endOffset": 102,
      "text": "Sistematično opazovanje in dokumentiranje prometa, rabe, podpore in političnega napredka."
    },
    {
      "sentenceId": "b-6deab8e13a93815c-s1",
      "blockIds": [
        "b-6deab8e13a93815c"
      ],
      "start": 90.47999999999999,
      "end": 91.35999999999999,
      "startOffset": 0,
      "endOffset": 10,
      "text": "Superblok."
    },
    {
      "sentenceId": "b-6deab8e13a93815c-s2",
      "blockIds": [
        "b-6deab8e13a93815c"
      ],
      "start": 91.75999999999999,
      "end": 100.24,
      "startOffset": 11,
      "endOffset": 139,
      "text": "Območje, kjer je tranzitni promet sistematično prekinjen, da se ulice v notranjosti lahko uporabljajo varneje in bolj raznoliko."
    },
    {
      "sentenceId": "b-ef05aa6abe8f5a07-s1",
      "blockIds": [
        "b-ef05aa6abe8f5a07"
      ],
      "start": 100.24,
      "end": 101.88,
      "startOffset": 0,
      "endOffset": 19,
      "text": "Taktični urbanizem."
    },
    {
      "sentenceId": "b-ef05aa6abe8f5a07-s2",
      "blockIds": [
        "b-ef05aa6abe8f5a07"
      ],
      "start": 102.08,
      "end": 108.32,
      "startOffset": 20,
      "endOffset": 104,
      "text": "Začasni, poceni posegi v mestni prostor, s katerimi pokažemo in testiramo spremembe."
    },
    {
      "sentenceId": "b-1efaebb8caa95324-s1",
      "blockIds": [
        "b-1efaebb8caa95324"
      ],
      "start": 108.32,
      "end": 109.67999999999999,
      "startOffset": 0,
      "endOffset": 17,
      "text": "Teorija sprememb."
    },
    {
      "sentenceId": "b-1efaebb8caa95324-s2",
      "blockIds": [
        "b-1efaebb8caa95324"
      ],
      "start": 110.16,
      "end": 117.52,
      "startOffset": 18,
      "endOffset": 122,
      "text": "Predpostavka o tem, kako nastajajo družbene in politične spremembe, ki pomaga zavestno izbirati taktike."
    },
    {
      "sentenceId": "b-c7e052ce4c80948b-s1",
      "blockIds": [
        "b-c7e052ce4c80948b"
      ],
      "start": 117.52,
      "end": 118.96,
      "startOffset": 0,
      "endOffset": 17,
      "text": "Tranzitni promet."
    },
    {
      "sentenceId": "b-c7e052ce4c80948b-s2",
      "blockIds": [
        "b-c7e052ce4c80948b"
      ],
      "start": 119.36,
      "end": 124.16,
      "startOffset": 18,
      "endOffset": 84,
      "text": "Promet, ki območje le prečka, ne da bi imel v njem cilj ali izvor."
    },
    {
      "sentenceId": "b-065e8507d197a186-s1",
      "blockIds": [
        "b-065e8507d197a186"
      ],
      "start": 124.16,
      "end": 125.11999999999999,
      "startOffset": 0,
      "endOffset": 12,
      "text": "Uokvirjanje."
    },
    {
      "sentenceId": "b-065e8507d197a186-s2",
      "blockIds": [
        "b-065e8507d197a186"
      ],
      "start": 125.6,
      "end": 131.76,
      "startOffset": 13,
      "endOffset": 101,
      "text": "Poimenovanje in pripoved problema ter njegove rešitve tako, da ju razumemo na nov način."
    },
    {
      "sentenceId": "b-87c6efb22deee7ff-s1",
      "blockIds": [
        "b-87c6efb22deee7ff"
      ],
      "start": 131.76,
      "end": 132.5,
      "startOffset": 0,
      "endOffset": 7,
      "text": "Zgodba."
    },
    {
      "sentenceId": "b-87c6efb22deee7ff-s2",
      "blockIds": [
        "b-87c6efb22deee7ff"
      ],
      "start": 132.81,
      "end": 135.84,
      "startOffset": 8,
      "endOffset": 59,
      "text": "Zgodba, s katero se iniciativa predstavlja navzven."
    },
    {
      "sentenceId": "b-87c6efb22deee7ff-s3",
      "blockIds": [
        "b-87c6efb22deee7ff"
      ],
      "start": 135.92,
      "end": 141.76,
      "startOffset": 60,
      "endOffset": 124,
      "text": "Ta jasno pove cilj, priložnost, zavezništva in želeno spremembo."
    },
    {
      "sentenceId": "b-7674646c1424783c-s1",
      "blockIds": [
        "b-7674646c1424783c"
      ],
      "start": 141.76,
      "end": 143.44,
      "startOffset": 0,
      "endOffset": 23,
      "text": "Leiwande Straßen Radar."
    },
    {
      "sentenceId": "b-7674646c1424783c-s2",
      "blockIds": [
        "b-7674646c1424783c"
      ],
      "start": 143.84,
      "end": 150.32,
      "startOffset": 24,
      "endOffset": 115,
      "text": "Popisni list za ocenjevanje kakovosti življenja, varnosti in potrebe po ukrepanju na ulici."
    },
    {
      "sentenceId": "b-a99508a072ee3501-s1",
      "blockIds": [
        "b-a99508a072ee3501"
      ],
      "start": 150.32,
      "end": 151.84,
      "startOffset": 0,
      "endOffset": 18,
      "text": "Street Shit Bingo."
    },
    {
      "sentenceId": "b-a99508a072ee3501-s2",
      "blockIds": [
        "b-a99508a072ee3501"
      ],
      "start": 152.32,
      "end": 160.48,
      "startOffset": 19,
      "endOffset": 135,
      "text": "Orodje za skupni sprehod, na katerem udeleženci odkrivajo ovire, nevarnosti in presenetljive rabe uličnega prostora."
    },
    {
      "sentenceId": "b-84dcb45dc44540e9-s1",
      "blockIds": [
        "b-84dcb45dc44540e9"
      ],
      "start": 160.48,
      "end": 162.16,
      "startOffset": 0,
      "endOffset": 20,
      "text": "Street Design Table."
    },
    {
      "sentenceId": "b-84dcb45dc44540e9-s2",
      "blockIds": [
        "b-84dcb45dc44540e9"
      ],
      "start": 162.39999999999998,
      "end": 169.67999999999998,
      "startOffset": 21,
      "endOffset": 123,
      "text": "Orodje za prilagajanje načrta ulice s papirnatimi elementi in raziskovanje alternativnih rab prostora."
    },
    {
      "sentenceId": "b-4faa80f7d025b2e0-s1",
      "blockIds": [
        "b-4faa80f7d025b2e0"
      ],
      "start": 169.67999999999998,
      "end": 170.79999999999998,
      "startOffset": 0,
      "endOffset": 14,
      "text": "Tree Love Set."
    },
    {
      "sentenceId": "b-4faa80f7d025b2e0-s2",
      "blockIds": [
        "b-4faa80f7d025b2e0"
      ],
      "start": 171.2,
      "end": 177.67999999999998,
      "startOffset": 15,
      "endOffset": 107,
      "text": "Komplet kostumov v obliki dreves, s katerimi pokažemo, kje sta potrebni senca in ozelenitev."
    },
    {
      "sentenceId": "b-a460b4d6b5ea6d5c-s1",
      "blockIds": [
        "b-a460b4d6b5ea6d5c"
      ],
      "start": 177.67999999999998,
      "end": 179.04,
      "startOffset": 0,
      "endOffset": 15,
      "text": "Načrt za zmago."
    },
    {
      "sentenceId": "b-a460b4d6b5ea6d5c-s2",
      "blockIds": [
        "b-a460b4d6b5ea6d5c"
      ],
      "start": 179.51999999999998,
      "end": 186.55999999999997,
      "startOffset": 16,
      "endOffset": 112,
      "text": "Načrt za doseganje spremembe, na primer zbrati 1.000 podpisov in jih predati lokalnim politikom."
    },
    {
      "sentenceId": "b-82cdf807d976ded4-s1",
      "blockIds": [
        "b-82cdf807d976ded4"
      ],
      "start": 186.55999999999997,
      "end": 188.07999999999998,
      "startOffset": 0,
      "endOffset": 21,
      "text": "izhlapevanje prometa."
    },
    {
      "sentenceId": "b-82cdf807d976ded4-s2",
      "blockIds": [
        "b-82cdf807d976ded4"
      ],
      "start": 188.47999999999996,
      "end": 195.99999999999997,
      "startOffset": 22,
      "endOffset": 136,
      "text": "Ko se cestni prostor za avtomobile zmanjša, se skupni promet pogosto zmanjša, namesto da bi se le preselil drugam."
    },
    {
      "sentenceId": "b-4cc3bc19382191dc-s1",
      "blockIds": [
        "b-4cc3bc19382191dc"
      ],
      "start": 195.99999999999997,
      "end": 197.75999999999996,
      "startOffset": 0,
      "endOffset": 23,
      "text": "kartiranje vročih točk."
    },
    {
      "sentenceId": "b-4cc3bc19382191dc-s2",
      "blockIds": [
        "b-4cc3bc19382191dc"
      ],
      "start": 198.23999999999998,
      "end": 207.91999999999996,
      "startOffset": 24,
      "endOffset": 158,
      "text": "Zbiranje izkušenj ljudi z določenimi kraji na skupnem zemljevidu, da se pokažejo vzorci, na primer toplotni otoki ali nevarni prehodi."
    },
    {
      "sentenceId": "b-683e9502ee86cee9-s1",
      "blockIds": [
        "b-683e9502ee86cee9"
      ],
      "start": 207.91999999999996,
      "end": 209.83999999999995,
      "startOffset": 0,
      "endOffset": 26,
      "text": "Public Life Data Protocol."
    },
    {
