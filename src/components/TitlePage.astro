---
// Title sheet for front matter.
import { getWork } from '../data/works';
import { smartQuotes } from '../lib/smart-quotes';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';
import BrandLogo from './BrandLogo.astro';
import PartnerLogos from './PartnerLogos.astro';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const work = getWork(lang);
// Catalogue metadata bypasses the markdown pipeline, so quotes are
// localised here to match the hast-transformed prose.
const sq = (value: string) => smartQuotes(value, lang);
---
<div class="sheet title-sheet">
  <h1 class="title-sheet__logo"><BrandLogo label={sq(work.title)} /></h1>
  <div class="title-sheet__details">
    <PartnerLogos />
    {work.contributor && <p><small>{t(lang, 'metadata.contributor', 'Contributors')}</small><br />{sq(work.contributor)}</p>}
  </div>
</div>

<style>
  .title-sheet {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-block-size: 38rem;
    gap: 5rem;
  }
  .title-sheet__details { font-family: var(--font-ui); font-size: 0.9rem; }
  .title-sheet__details :global(.partner-logos) {
    padding-inline: 0;
    margin-block: 0 2rem;
  }
  .title-sheet__details small { color: var(--ink-soft); }
  .title-sheet__logo :global(.brand-art) {
    inline-size: 32rem;
    max-inline-size: 100%;
  }
  @media print {
    .title-sheet { min-block-size: 255mm; }
  }
</style>
