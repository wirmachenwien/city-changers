---
import Icon, { type IconName } from './Icon.astro';
import type { Language } from '../data/locales';
import { smartQuotes } from '../lib/smart-quotes';

interface Props {
  lang?: Language;
}

interface TextField {
  key: string;
  label: string;
  icon: IconName;
  lines?: number;
  featured?: boolean;
}

interface ChoiceGroup {
  title: string;
  icon: IconName;
  hint: string;
  items: { key: string; label: string }[];
}

const { lang = 'de' } = Astro.props;

const textGroups: { title: string; fields: TextField[] }[] = [
  {
    title: 'Ausrichtung',
    fields: [
      { key: 'initiative-purpose', label: 'Ziel', icon: 'target', lines: 3, featured: true },
      { key: 'initiative-solution', label: 'Räumliche Lösung', icon: 'solution', lines: 4 },
      { key: 'initiative-first-action', label: 'Erste sichtbare Aktion', icon: 'steps', lines: 4 },
    ],
  },
  {
    title: 'Verbündete und Erzählung',
    fields: [
      { key: 'initiative-established-allies', label: 'Bereits etablierte Verbindungen', icon: 'allies', lines: 3 },
      { key: 'initiative-potential-allies', label: 'Potenzielle Verbündete', icon: 'group', lines: 3 },
      { key: 'initiative-narrative', label: 'Narrativ', icon: 'narrative', lines: 5, featured: true },
    ],
  },
  {
    title: 'Entscheidung und Belege',
    fields: [
      { key: 'initiative-current-debate', label: 'Aktuelle Debatte', icon: 'narrative', lines: 4 },
      { key: 'initiative-decision-level', label: 'Wichtigste Entscheidungsebene', icon: 'politics', lines: 6 },
      { key: 'initiative-opposition', label: 'Potenzielle Gegenstimmen', icon: 'politics', lines: 5 },
      { key: 'initiative-evidence', label: 'Wichtigste Belege', icon: 'evidence', lines: 4 },
      { key: 'initiative-monitoring', label: 'Monitoring-Methode', icon: 'evidence', lines: 4 },
    ],
  },
  {
    title: 'Nächste Arbeitsphase',
    fields: [
      { key: 'initiative-next-steps', label: 'Aufgabenplan', icon: 'steps', lines: 6, featured: true },
    ],
  },
];

const choiceGroups: ChoiceGroup[] = [
  {
    title: 'Aktuelle Schwerpunkte',
    icon: 'priority',
    hint: 'Empfehlung: markiert zwei Schwerpunkte für die nächste Arbeitsphase.',
    items: [
      { key: 'focus-allies', label: 'Umfeld an Verbündeten erweitern' },
      { key: 'focus-evidence', label: 'Mehr Belege bzw. Hintergrundwissen zum Anliegen sammeln' },
      { key: 'focus-attention', label: 'Mehr Aufmerksamkeit für die Initiative erzeugen' },
      { key: 'focus-growth', label: 'Initiative selbst vergrößern' },
      { key: 'focus-decision-makers', label: 'Ziele mit Entscheidungsträger:innen diskutieren' },
    ],
  },
  {
    title: 'Handlungsoptionen',
    icon: 'priority',
    hint: 'Markiert drei bis fünf Optionen, die jetzt zum Ziel passen.',
    items: [
      { key: 'option-direct-contact', label: 'Direkte Kontaktaufnahme mit potenziellen Verbündeten planen' },
      { key: 'option-workshop', label: 'Zu Diskussion oder Aktivität einladen, zum Beispiel Street Design Workshop' },
      { key: 'option-door', label: 'Haustürgespräche vorbereiten' },
      { key: 'option-petition', label: 'Petition via Stadt Wien Portal oder aufstehn.at prüfen' },
      { key: 'option-background-talks', label: 'Hintergrundgespräche mit Personen in relevanten Positionen führen' },
      { key: 'option-learn-network', label: 'Von anderen Initiativen im Wir machen Wien-Netzwerk lernen' },
      { key: 'option-traffic-count', label: 'Verkehrszählung durchführen' },
      { key: 'option-info-request', label: 'Amtliche Informationen anfragen' },
      { key: 'option-planning', label: 'In aktuelle Planung Einblick nehmen' },
      { key: 'option-press', label: 'Pressearbeit vorbereiten' },
      { key: 'option-social', label: 'Social-Media-Beiträge oder Reel planen' },
      { key: 'option-online', label: 'Onlinepräsenz aktualisieren' },
      { key: 'option-action', label: 'Aktion vor Ort planen' },
      { key: 'option-local-ads', label: 'Werbung vor Ort vorbereiten' },
      { key: 'option-recruit', label: 'Mehr Personen anwerben' },
      { key: 'option-structure', label: 'Gruppenstruktur aufbauen' },
      { key: 'option-association', label: 'Vereinsgründung prüfen' },
      { key: 'option-budget', label: 'Budget oder Förderungen organisieren' },
      { key: 'option-present', label: 'Belege und Verbündete präsentieren' },
      { key: 'option-negotiation', label: 'Antworten auf erwartbare Argumente und mögliche Kompromisse vorbereiten' },
    ],
  },
];

function textField(field: TextField, asHeading = false) {
  const label = smartQuotes(field.label, lang);
  return { field, label, asHeading };
}
---
<section class="initiative-steckbrief" data-checklist="de-initiativen-steckbrief" aria-labelledby="initiative-steckbrief-title">
  <header class="initiative-steckbrief-hero">
    <div class="initiative-steckbrief-title-row initiative-commit-cell" data-commit-root data-commit-text-root>
      <span class="initiative-steckbrief-hero-icon"><Icon name="group" /></span>
      <input type="text" class="initiative-commit-input initiative-steckbrief-title-input" name="initiative-title" data-checklist-field="initiative-title" data-commit-input placeholder="Titel der Initiative" aria-label="Titel der Initiative" autocomplete="off" />
      <div class="initiative-commit-display initiative-commit-display--text initiative-steckbrief-title-display" data-commit-display hidden>
        <h2 id="initiative-steckbrief-title" class="initiative-steckbrief-title" data-commit-text></h2>
        <button type="button" class="initiative-commit-pencil" data-commit-edit aria-label="Titel der Initiative bearbeiten"><Icon name="pencil" /></button>
      </div>
    </div>

    <div class="initiative-steckbrief-location initiative-commit-cell" data-commit-root data-commit-text-root>
      <span class="initiative-steckbrief-inline-icon"><Icon name="location" /></span>
      <input type="text" class="initiative-commit-input" name="initiative-area" data-checklist-field="initiative-area" data-commit-input placeholder="Gebiet oder Ort" aria-label="Gebiet abgrenzen" autocomplete="off" />
      <div class="initiative-commit-display initiative-commit-display--text initiative-steckbrief-inline-display" data-commit-display hidden>
        <span class="initiative-commit-value" data-commit-text></span>
        <button type="button" class="initiative-commit-pencil" data-commit-edit aria-label="Gebiet abgrenzen bearbeiten"><Icon name="pencil" /></button>
      </div>
    </div>
  </header>

  <section class="initiative-steckbrief-section initiative-steckbrief-team initiative-list-field--with-icons initiative-list-field--people" data-checklist-list="initiative-active" data-checklist-list-initial="3" aria-labelledby="initiative-team-title">
    <div class="initiative-steckbrief-section-head">
      <span class="initiative-steckbrief-section-icon"><Icon name="group" /></span>
      <div>
        <h3 id="initiative-team-title">Team</h3>
        <p>Namen, Rollen und Fähigkeiten der aktiven Personen.</p>
      </div>
    </div>
    <div class="initiative-list-table initiative-list-table--people" role="group" aria-label="Team" style="--list-cols: 3">
      <div class="initiative-list-rows" data-checklist-list-rows>
        {Array.from({ length: 3 }, (_, rowIndex) => (
          <div class="initiative-list-row initiative-person-card" data-checklist-list-row>
            <span class="initiative-list-marker"><Icon name="person" /></span>
            <div class="initiative-list-cell initiative-commit-cell" data-commit-root data-commit-text-root>
              <span class="initiative-list-cell-label">Name</span>
              <input type="text" class="initiative-commit-input" name={`initiative-active.${rowIndex}.name`} data-checklist-field={`initiative-active.${rowIndex}.name`} data-commit-input placeholder="Name eintippen …" aria-label="Name" autocomplete="off" />
              <div class="initiative-commit-display initiative-commit-display--text" data-commit-display hidden>
                <span class="initiative-commit-value" data-commit-text></span>
                <button type="button" class="initiative-commit-pencil" data-commit-edit aria-label="Name bearbeiten"><Icon name="pencil" /></button>
              </div>
            </div>
            <div class="initiative-list-cell initiative-roles-cell initiative-tag-commit-cell initiative-commit-cell" data-tags-root data-commit-root data-tag-commit-root>
              <span class="initiative-list-cell-label">Rollen</span>
              <input type="text" class="initiative-tags-value" name={`initiative-active.${rowIndex}.roles`} data-checklist-field={`initiative-active.${rowIndex}.roles`} data-tags-value hidden tabindex="-1" aria-hidden="true" />
              <div class="initiative-tag-commit-box" data-tags>
                <span class="initiative-roles-chips initiative-tag-commit-chips" data-tags-list aria-live="polite"></span>
                <input type="text" class="initiative-tag-commit-input" data-tags-input data-tag-commit-input data-commit-input placeholder="Rolle eintippen …" aria-label="Rollen" autocomplete="off" />
              </div>
              <button type="button" class="initiative-commit-display" data-commit-display hidden>
                <span class="initiative-commit-pills" data-commit-pills></span>
                <span class="initiative-commit-pencil"><Icon name="pencil" /></span>
              </button>
            </div>
            <button type="button" class="initiative-list-remove" data-checklist-list-remove aria-label="Eintrag entfernen" title="Eintrag entfernen"><Icon name="minus" /></button>
            <div class="initiative-list-cell initiative-below-cell initiative-roles-cell initiative-tag-commit-cell initiative-commit-cell" data-tags-root data-commit-root data-tag-commit-root data-commit-bullets>
              <span class="initiative-below-label">Fähigkeiten</span>
              <input type="text" class="initiative-tags-value" name={`initiative-active.${rowIndex}.skills`} data-checklist-field={`initiative-active.${rowIndex}.skills`} data-tags-value hidden tabindex="-1" aria-hidden="true" />
              <div class="initiative-tag-commit-box initiative-tag-commit-box--list" data-tags>
                <ul class="initiative-tag-list" data-tags-list aria-live="polite"></ul>
                <div class="initiative-tag-add-row">
                  <span class="initiative-tag-add-dash" aria-hidden="true">–</span>
                  <input type="text" class="initiative-tag-commit-input" data-tags-input data-tag-commit-input data-commit-input placeholder="Fähigkeit eintippen …" aria-label="Fähigkeiten" autocomplete="off" />
                </div>
              </div>
              <div class="initiative-commit-display initiative-commit-display--list" data-commit-display hidden>
                <ul class="initiative-commit-list" data-commit-pills></ul>
                <button type="button" class="initiative-commit-add-row" data-commit-add aria-label="Fähigkeiten hinzufügen"><span class="initiative-commit-add-dash" aria-hidden="true">–</span><span>Fähigkeit eintippen …</span></button>
              </div>
            </div>
          </div>
        ))}
        <button type="button" class="initiative-list-add initiative-person-add" data-checklist-list-add><Icon name="person" />Weitere Person hinzufügen</button>
      </div>
    </div>
    <template data-checklist-list-template>
      <div class="initiative-list-row initiative-person-card" data-checklist-list-row>
        <span class="initiative-list-marker"><Icon name="person" /></span>
        <div class="initiative-list-cell initiative-commit-cell" data-commit-root data-commit-text-root>
          <span class="initiative-list-cell-label">Name</span>
          <input type="text" class="initiative-commit-input" name="initiative-active.__INDEX__.name" data-checklist-field="initiative-active.__INDEX__.name" data-commit-input placeholder="Name eintippen …" aria-label="Name" autocomplete="off" />
          <div class="initiative-commit-display initiative-commit-display--text" data-commit-display hidden><span class="initiative-commit-value" data-commit-text></span><button type="button" class="initiative-commit-pencil" data-commit-edit aria-label="Name bearbeiten"><Icon name="pencil" /></button></div>
        </div>
        <div class="initiative-list-cell initiative-roles-cell initiative-tag-commit-cell initiative-commit-cell" data-tags-root data-commit-root data-tag-commit-root>
          <span class="initiative-list-cell-label">Rollen</span>
          <input type="text" class="initiative-tags-value" name="initiative-active.__INDEX__.roles" data-checklist-field="initiative-active.__INDEX__.roles" data-tags-value hidden tabindex="-1" aria-hidden="true" />
          <div class="initiative-tag-commit-box" data-tags><span class="initiative-roles-chips initiative-tag-commit-chips" data-tags-list aria-live="polite"></span><input type="text" class="initiative-tag-commit-input" data-tags-input data-tag-commit-input data-commit-input placeholder="Rolle eintippen …" aria-label="Rollen" autocomplete="off" /></div>
          <button type="button" class="initiative-commit-display" data-commit-display hidden><span class="initiative-commit-pills" data-commit-pills></span><span class="initiative-commit-pencil"><Icon name="pencil" /></span></button>
        </div>
        <button type="button" class="initiative-list-remove" data-checklist-list-remove aria-label="Eintrag entfernen" title="Eintrag entfernen"><Icon name="minus" /></button>
        <div class="initiative-list-cell initiative-below-cell initiative-roles-cell initiative-tag-commit-cell initiative-commit-cell" data-tags-root data-commit-root data-tag-commit-root data-commit-bullets>
          <span class="initiative-below-label">Fähigkeiten</span>
          <input type="text" class="initiative-tags-value" name="initiative-active.__INDEX__.skills" data-checklist-field="initiative-active.__INDEX__.skills" data-tags-value hidden tabindex="-1" aria-hidden="true" />
          <div class="initiative-tag-commit-box initiative-tag-commit-box--list" data-tags><ul class="initiative-tag-list" data-tags-list aria-live="polite"></ul><div class="initiative-tag-add-row"><span class="initiative-tag-add-dash" aria-hidden="true">–</span><input type="text" class="initiative-tag-commit-input" data-tags-input data-tag-commit-input data-commit-input placeholder="Fähigkeit eintippen …" aria-label="Fähigkeiten" autocomplete="off" /></div></div>
          <div class="initiative-commit-display initiative-commit-display--list" data-commit-display hidden><ul class="initiative-commit-list" data-commit-pills></ul><button type="button" class="initiative-commit-add-row" data-commit-add aria-label="Fähigkeiten hinzufügen"><span class="initiative-commit-add-dash" aria-hidden="true">–</span><span>Fähigkeit eintippen …</span></button></div>
        </div>
      </div>
    </template>
  </section>

  {textGroups.map((group) => (
    <section class="initiative-steckbrief-section">
      <h3>{group.title}</h3>
      <div class="initiative-steckbrief-grid">
        {group.fields.map((field) => {
          const item = textField(field);
          return (
            <article class:list={["initiative-steckbrief-card", field.featured && "initiative-steckbrief-card--wide", "initiative-commit-cell"]} data-commit-root data-commit-text-root>
              <span class="initiative-steckbrief-card-icon"><Icon name={field.icon} /></span>
              <div class="initiative-steckbrief-card-body">
                <span class="initiative-steckbrief-label">{item.label}</span>
                <textarea class="initiative-commit-input initiative-note-textarea" name={field.key} data-checklist-field={field.key} data-commit-input rows={field.lines ?? 3} aria-label={item.label} placeholder={item.label}></textarea>
                <div class="initiative-commit-display initiative-commit-display--text" data-commit-display hidden>
                  <span class="initiative-commit-value initiative-commit-value--long" data-commit-text></span>
                  <button type="button" class="initiative-commit-pencil" data-commit-edit aria-label={`${item.label} bearbeiten`}><Icon name="pencil" /></button>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}

  <section class="initiative-steckbrief-section initiative-steckbrief-section--choices">
    <h3>Priorisierung</h3>
    <div class="initiative-steckbrief-grid">
      {choiceGroups.map((group, groupIndex) => (
        <fieldset class="initiative-steckbrief-card initiative-steckbrief-card--wide initiative-section-commit" data-section-commit>
          <legend><span class="initiative-steckbrief-card-icon"><Icon name={group.icon} /></span>{smartQuotes(group.title, lang)}</legend>
          <p>{smartQuotes(group.hint, lang)}</p>
          <ul>
            {group.items.map((item, itemIndex) => {
              const inputId = `de-initiativen-steckbrief-${groupIndex}-${itemIndex}`;
              return (
                <li>
                  <input id={inputId} type="checkbox" name={item.key} value="1" data-checklist-field={item.key} />
                  <label for={inputId}>{smartQuotes(item.label, lang)}</label>
                </li>
              );
            })}
          </ul>
          <button type="button" class="initiative-commit-display initiative-section-commit-display" data-section-commit-display hidden>
            <span class="initiative-commit-pills" data-section-commit-values></span>
            <span class="initiative-commit-pencil"><Icon name="pencil" /></span>
          </button>
        </fieldset>
      ))}
    </div>
  </section>
</section>
