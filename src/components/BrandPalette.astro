---
import registry from '../../design/colors.json';
const families: Record<string, Record<string, string>> = registry.families;
const colors = registry.palette.map((color) => {
  const [family, shade] = color.ref.split('.');
  const hex = families[family]?.[shade];
  if (!hex) throw new Error(`Unknown brand palette reference: ${color.ref}`);
  return { ...color, hex };
});
---
<ul class="color-grid">
  {colors.map(({ name, hex, use }) => (
    <li class="showcase-demo"><span class="swatch shape" style={{ '--swatch-color': hex }} aria-hidden="true"></span><strong>{name}</strong> <code><span class="color-value"><span class="color-pebble" style={{ '--pebble-color': hex }} aria-hidden="true"></span>{hex}</span></code><small>{use}</small></li>
  ))}
</ul>
<style>
  .color-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); padding: 0; list-style: none; }
  .color-grid li { margin: 0; padding: .75rem; --drawn-stroke: var(--line); }
  /* Grid gaps replace prose list spacing so every card fills its row equally. */
  .color-grid li + li { margin-block-start: 0; }
  .color-grid small { display: block; }
  .swatch { display: block; height: 3rem; border: 1px solid var(--line); margin-block-end: .75rem; background: var(--swatch-color); }
  @media screen and (forced-colors: none) {
    @supports (mask-image: url('')) {
      .swatch { background: transparent; border-color: transparent; --drawn-fill: var(--swatch-color); --drawn-stroke: var(--line); }
    }
  }
</style>
