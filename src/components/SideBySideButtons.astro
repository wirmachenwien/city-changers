---
import DownloadLink from './DownloadLink.astro';
import ButtonLink from './ButtonLink.astro';
import type { IconName } from '../lib/icons';
import { downloadEnabled } from '../lib/downloads';
import { audioPublication } from '../lib/audio-publication.mjs';
import type { Language } from '../data/locales';

interface Link {
  href: string;
  label: string;
  iconBefore?: IconName;
  iconAfter?: IconName;
}

interface Props {
  links: Link[];
  audioLang?: Language;
}

const { links, audioLang } = Astro.props;
const visibleLinks = links.filter((link) => downloadEnabled(link.href));
const audiobook = audioLang && audioPublication().audiobooks.find((book: any) => book.lang === audioLang);
const audioLabels = audioLang && {
  en: { download: 'Download audiobook' },
  de: { download: 'Hörbuch herunterladen' },
  sl: { download: 'Prenesi zvočno knjigo' },
}[audioLang];
---
{(visibleLinks.length > 0 || audiobook) && (
  <div class="download-buttons">
    {visibleLinks.map((link) => <DownloadLink href={link.href} iconBefore={link.iconBefore} iconAfter={link.iconAfter}>{link.label}</DownloadLink>)}
    {audiobook && audioLabels && <ButtonLink href={audiobook.url} iconBefore="play-out-loud" download>{audioLabels.download}</ButtonLink>}
  </div>
)}
