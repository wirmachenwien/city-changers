---
import catalogSource from '../../public/brand-assets/catalog.json?raw';
import MascotPreview from './MascotPreview.astro';
import mascots from '../data/mascots.json';
import { withBase } from '../lib/site';

type Asset = { file: string; title: string; bytes: number };
const assets: Asset[] = JSON.parse(catalogSource);
const groups = [...new Set(assets.map((asset) => asset.title))];
const assetUrl = (file: string) => withBase(`/brand-assets/files/${file.split('/').map(encodeURIComponent).join('/')}`);

function lottiePreview(file: string) {
  const match = file.match(/\/green-fix-([a-z]+)-(ink|linen)\.json$/);
  if (!match || !Object.hasOwn(mascots, match[1])) return undefined;
  return { pose: match[1] as keyof typeof mascots, treatment: match[2] as 'ink' | 'linen' };
}
---
<h2 id="downloads">Downloads</h2>
<p>Download the complete kit, or open a category below for individual files. These files and the kit are packaged from the same asset manifest; no artwork is regenerated by this page.</p>
<p><a href={withBase('/brand-assets/city-changers-brand-kit.zip')} download>Download the brand kit (ZIP)</a></p>
<p><a href={assetUrl('BRAND-GUIDE.md')} download>Brand guidelines (Markdown)</a> · <a href={assetUrl('COLOR-REFERENCE.md')} download>Technical color reference</a> · <a href={assetUrl('COLORS.json')} download>Color registry (JSON)</a></p>
{groups.map((title) => (
  <details class="asset-category">
    <summary>{title} <small>({assets.filter((asset) => asset.title === title).length} files)</small></summary>
    {title === 'Lottie animations' && <p>Animations play once when they enter view. Hover, click or use Enter or Space to replay. Reduced-motion views show stills. Review animations before publication.</p>}
    <ul class="asset-grid">
      {assets.filter((asset) => asset.title === title).map((asset) => {
        const preview = lottiePreview(asset.file);
        return (
          <li>
            {preview && (
              <div class:list={['asset-preview', { 'asset-preview--dark': preview.treatment === 'linen' }]}>
                <div class="lottie-artwork"><MascotPreview pose={preview.pose} treatment={preview.treatment} /></div>
              </div>
            )}
            {/\.(png|svg|jpg)$/i.test(asset.file) && (
              <div class:list={['asset-preview', { 'asset-preview--dark': /linen|dark/.test(asset.file) }]}>
                <img src={assetUrl(asset.file)} alt="" loading="lazy" width="240" height="180" />
              </div>
            )}
            <a href={assetUrl(asset.file)} download>{asset.file.split('/').slice(-2).join('/')}</a>
            <small>{asset.bytes < 1048576 ? `${Math.ceil(asset.bytes / 1024)} KB` : `${(asset.bytes / 1048576).toFixed(1)} MB`}</small>
          </li>
        );
      })}
    </ul>
  </details>
))}
<style>
  .asset-category { margin-block: 1rem; }
  summary { cursor: pointer; font-weight: 700; }
  summary small { font-weight: 400; }
  .asset-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    list-style: none;
    padding: 0;
  }
  .asset-grid li { border: 1px solid var(--line); border-radius: .5rem; padding: .75rem; min-width: 0; }
  .asset-grid a { display: flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .asset-grid small { display: block; }
  .asset-preview { display: grid; place-items: center; background: var(--art-paper); border-radius: .25rem; padding: .75rem; }
  .asset-preview--dark { background: var(--art-dark); }
  .asset-preview img { width: 100%; height: 180px; object-fit: contain; }
  .lottie-artwork { width: min(100%, 180px); }
</style>
