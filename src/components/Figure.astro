---
// Responsive figure backed by bundled image assets. Looks up raster images
// by filename across the book and site asset folders and renders an
// optimised srcset; captions come from the default slot.
import { Image } from 'astro:assets';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  src: string;
  alt: string;
  caption?: string;
  eager?: boolean;
  lang?: Language;
  /** Render the image on a white card (brand lockups such as the
   *  Erasmus+ logo that must sit on white per brand rules). */
  frame?: 'white';
  /** Constrain the rendered figure width without changing image optimisation. */
  size?: 'small' | 'medium';
  /** Let prose wrap around the figure on wide screens, or center it as a block. */
  float?: 'left' | 'right' | 'center';
}

const { src, alt, caption, eager = false, lang, frame, size, float } = Astro.props;
// Prop-supplied text bypasses the markdown pipeline, so quotes are localised
// here to match the hast-transformed prose (only when lang is known).
const displayAlt = lang ? smartQuotes(alt, lang) : alt;
const displayCaption = caption && lang ? smartQuotes(caption, lang) : caption;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true },
);

const match = Object.entries(images).find(([path]) =>
  path.endsWith(`/${src.split('/').pop()}`),
);
if (!match) {
  throw new Error(`Figure: unknown image "${src}"`);
}
const image = match[1].default;
const hasCaption = displayCaption || Astro.slots.has('default');
const imageSizes =
  size === 'small'
    ? 'min(100vw, 18rem)'
    : size === 'medium'
      ? 'min(100vw, 28rem)'
      : '(max-width: 44rem) 100vw, 44rem';
---
<figure
  class:list={[
    'figure',
    frame === 'white' && 'figure--framed',
    size && `figure--${size}`,
    float && `figure--float-${float}`,
  ]}
>
  <Image
    src={image}
    alt={displayAlt}
    title={displayAlt || undefined}
    widths={[400, 800, 1200]}
    sizes={imageSizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {hasCaption && <figcaption>{displayCaption ?? <slot />}</figcaption>}
</figure>
