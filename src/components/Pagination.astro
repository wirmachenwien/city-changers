---
// Previous/next pagination. Dumb renderer: the "which pages paginate" rule
// lives in `paginationNeighbours` (src/data/works.ts); layouts pass the
// resolved prev/next in. Style follows
// settings.web.paginationType: previous-next | titles | title-arrows | arrows.
import { settings } from '../data/settings';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';
import type { NeighbourEntry } from '../data/book-toc';

interface Props {
  lang: Language;
  prev: NeighbourEntry | null;
  next: NeighbourEntry | null;
}

const { lang, prev, next } = Astro.props;
const type = settings.web.paginationType;

function label(entry: NeighbourEntry, direction: 'prev' | 'next'): string {
  const arrow = direction === 'prev' ? '←' : '→';
  const fallback = direction === 'prev' ? t(lang, 'nav.previous', 'Previous') : t(lang, 'nav.next', 'Next');
  if (type === 'arrows') return arrow;
  if (type === 'previous-next') return fallback;
  if (type === 'titles') return entry.label;
  // Keep each arrow with its neighbouring word instead of orphaning it.
  return direction === 'prev' ? `${arrow}\u00a0${entry.label}` : `${entry.label}\u00a0${arrow}`;
}
---
{(prev || next) && (
  <div class="pagination">
    <nav aria-label={t(lang, 'nav.toc', 'Contents')}>
      {prev ? (
        <a class="prev" rel="prev" href={prev.url}>{label(prev, 'prev')}</a>
      ) : (
        <span />
      )}
      {next && (
        <a class="next" rel="next" href={next.url}>{label(next, 'next')}</a>
      )}
    </nav>
  </div>
)}
