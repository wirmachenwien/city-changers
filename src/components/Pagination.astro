---
// Previous/next pagination. Dumb renderer: the "which pages paginate" rule
// lives in `paginationNeighbours` (src/data/works.ts); layouts pass the
// resolved prev/next in. Style follows
// settings.web.paginationType: previous-next | titles | title-arrows | arrows.
import { settings } from '../data/settings';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';
import type { NeighbourEntry } from '../data/book-toc';
import Icon from './Icon.astro';

interface Props {
  lang: Language;
  prev: NeighbourEntry | null;
  next: NeighbourEntry | null;
}

const { lang, prev, next } = Astro.props;
const type = settings.web.paginationType;
const arrows = type === 'arrows' || type === 'title-arrows';

function label(entry: NeighbourEntry, direction: 'prev' | 'next'): string {
  const fallback = direction === 'prev' ? t(lang, 'nav.previous', 'Previous') : t(lang, 'nav.next', 'Next');
  if (type === 'previous-next') return fallback;
  return entry.label;
}
---
{(prev || next) && (
  <div class="pagination">
    <nav aria-label={t(lang, 'nav.toc', 'Contents')}>
      {prev ? (
        <a class="prev" rel="prev" href={prev.url} aria-label={type === 'arrows' ? label(prev, 'prev') : undefined} data-link-underline={type === 'arrows' ? undefined : 'pagination'}>
          {arrows && <Icon name="arrow-left" />}{type !== 'arrows' && <span data-pagination-label><span data-pagination-text>{label(prev, 'prev')}</span></span>}
        </a>
      ) : (
        <span />
      )}
      {next && (
        <a class="next" rel="next" href={next.url} aria-label={type === 'arrows' ? label(next, 'next') : undefined} data-link-underline={type === 'arrows' ? undefined : 'pagination'}>
          {type !== 'arrows' && <span data-pagination-label><span data-pagination-text>{label(next, 'next')}</span></span>}{arrows && <Icon name="arrow-right" />}
        </a>
      )}
    </nav>
  </div>
)}
<script>
  import { initPaginationUnderlines } from '../scripts/pagination-underlines';
  initPaginationUnderlines();
</script>
