---
 // Compact language dropdown for navigation and footer: globe icon plus a native
 // select that navigates on change (wired by the shared select enhancer).
 // The full link list in the footer stays the no-JS fallback.
import { alternates } from '../lib/alternates';
import { locales } from '../data/locales';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';
import Icon from './Icon.astro';
import DrawnSelect from './DrawnSelect.astro';

interface Props {
  lang: Language;
  kind: 'page' | 'book';
  file: string;
  id?: string;
}

const { lang, kind, file, id = 'language-select' } = Astro.props;
const targets = await alternates(kind, file);
const options = targets.map(target => ({
  href: target.url,
  label: (locales[target.lang] as { 'local-name'?: string })['local-name'] ?? target.lang,
  selected: target.lang === lang,
}));
---
<span class="lang-menu" data-select-list>
  <label class="visually-hidden" for={id}>
    {t(lang, 'controls.language-select', 'Select language')}
  </label>
  <Icon name="globe" />
  <DrawnSelect {id} {options} />
  <noscript>
    <a href={targets.find((target) => target.lang !== lang)?.url}>
      {t(lang, 'controls.language-select', 'Select language')}
    </a>
  </noscript>
</span>
