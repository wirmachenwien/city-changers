---
// Card-style visual table of contents for chapter overviews.
import { bookToc } from '../data/book-toc';
import { t } from '../lib/i18n';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const entries = await bookToc(lang);
---
<nav class="visual-toc" aria-label={t(lang, 'nav.toc', 'Contents')}>
  {entries.map((entry) => (
    <a href={entry.url} aria-label={`${t(lang, 'visual-toc.link-to-page-assistive-text', 'Link to page')}: ${entry.label}`}>
      {entry.label}
    </a>
  ))}
</nav>
