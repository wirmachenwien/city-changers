---
// Sidebar navigation for wide screens (same model as the drawer), with the
// personal bookmark list directly after the main section. The
// list itself is rendered client-side from localStorage when marks exist.
import { combinedNav, type NavLink } from '../lib/nav';
import { t } from '../lib/i18n';
import { settings } from '../data/settings';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
  currentUrl: string;
}

interface LinkSection {
  kind: 'links';
  heading: string | null;
  links: NavLink[];
}

interface BookmarkSection {
  kind: 'bookmarks';
}

type Section = LinkSection | BookmarkSection;

const { lang, currentUrl } = Astro.props;
const { project: projectLinks, book, position } = combinedNav(lang, currentUrl);

// Project (Start) and book (Contents … Glossary) render as one continuous
// list so there is no gap between Start and Contents.
const mainLinks: NavLink[] =
  position === 'before' ? [...projectLinks, ...book] : [...book, ...projectLinks];
const mainSection: LinkSection = { kind: 'links', heading: null, links: mainLinks };
const bookmarkSection: BookmarkSection = { kind: 'bookmarks' };

const ordered: Section[] = [mainSection];
// The bookmark list always sits directly after the main section.
if (settings.web.bookmarks.enabled) {
  ordered.splice(ordered.indexOf(mainSection) + 1, 0, bookmarkSection);
}

const bookmarkHeading = t(lang, 'bookmarks.bookmarks', 'Bookmarks');
const deleteLabel = t(lang, 'bookmarks.delete-bookmark', 'Delete');
---
<div class="side-nav">
  {ordered.map((section) =>
    section.kind === 'bookmarks' ? (
      <section class="nav-section" data-bookmark-nav hidden>
        <h2>{bookmarkHeading}</h2>
        <ul
          class="nav-list bookmark-list"
          data-bookmark-list
          data-lang={lang}
          data-delete-label={deleteLabel}
        />
      </section>
    ) : (
      section.links.length > 0 && (
        <section class="nav-section">
          {section.heading && <h2>{section.heading}</h2>}
          <ul class="nav-list">
            {section.links.map((link) => (
              <li>
                <a href={link.url} aria-current={link.current ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    ),
  )}
</div>
