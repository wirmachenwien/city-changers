---
 // Site masthead: brand mark, search shortcut, theme toggle, menu button.
 // Breadcrumbs live with the article heading (single source, no duplication).
import { settings } from '../data/settings';
import { projectText, t } from '../lib/i18n';
import { smartQuotes } from '../lib/smart-quotes';
import { withBase, DEFAULT_LANG } from '../lib/site';
import type { Language } from '../data/locales';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import BrandLogo from './BrandLogo.astro';
import boundary from '../../design/elements/lines/divider-strong.svg?raw';

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const text = projectText(lang);
const searchParam = settings.web.search.param;
// One master for both the accent stroke and its soft-accent silhouette. Only the
// decorative paint is shaped; header content and focus rings are not clipped.
const boundaryPath = boundary.match(/<path d="([^"]+)"/)?.[1];
if (!boundaryPath) throw new Error('Missing masthead boundary path');
const surfacePath = `M0 0V12${boundaryPath.replace(/^M/, 'L')}H960V0Z`;
---
<header class="site-head">
  <svg class="site-head__edge" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 960 24" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d={surfacePath} fill="var(--accent-soft)" />
    <path d={boundaryPath} fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" />
  </svg>
  <div class="site-head-inner">
    <div class="site-head-main">
      <a class="brand" href={withBase(lang === DEFAULT_LANG ? '/' : `/${lang}/`)}>
        <BrandLogo label={smartQuotes(text.name, lang)} animated />
      </a>
      <button type="button" class="menu-toggle" data-drawer-toggle aria-expanded="false" aria-label={t(lang, 'nav.menu', 'Menu')}>
        <span class="menu-icon"><Icon name="menu" /></span>
        <span class="menu-icon menu-icon--close"><Icon name="x" /></span>
        <span class="menu-label">{t(lang, 'nav.menu', 'Menu')}</span>
      </button>
    </div>
    <div class="site-head-tools">
      <form class="search-form search-form--mini" role="search" action={withBase(lang === DEFAULT_LANG ? '/search.html' : `/${lang}/search.html`)} method="get" data-search-form>
        <label class="visually-hidden" for="head-search">
          {t(lang, 'search.search-title', 'Search')}
        </label>
        <span class="search-box">
          <Icon name="search" />
          <input
            id="head-search"
            type="search"
            name={searchParam}
            placeholder={t(lang, 'search.placeholder', 'Search…')}
            autocomplete="off"
          />
          <button class="search-submit" type="submit" aria-label={t(lang, 'search.search-title', 'Search')}>
            <Icon name="chevron-right" />
          </button>
        </span>
      </form>
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>
