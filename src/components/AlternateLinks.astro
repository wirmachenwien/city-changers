---
// hreflang alternates (plus x-default) for the document head.
import { alternates, canonical, DEFAULT_LANG } from '../lib/site';
import { webBookToc } from '../data/works';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
  kind: 'page' | 'book';
  file: string;
}

const { kind, file } = Astro.props;
const targets = alternates(kind, file).filter((target) => (
  kind === 'book' ? webBookToc(target.lang).some((entry) => entry.file === file) : true
));
const fallback = targets.find((target) => target.lang === DEFAULT_LANG) ?? targets[0];
---
{targets.map((target) => (
  <link rel="alternate" hreflang={target.lang} href={canonical(target.url)} />
))}
{fallback && <link rel="alternate" hreflang="x-default" href={canonical(fallback.url)} />}
