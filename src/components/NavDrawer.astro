---
// Slide-over navigation: project links plus the expandable book index,
// with the personal bookmark list directly after the main section
// (same position as the desktop sidebar). The list itself is rendered
// client-side from localStorage when marks exist (see bookmarks.ts, which
// fills every [data-bookmark-list] on the page, sidebar and drawer alike).
import { combinedNav, type NavLink } from '../lib/nav';
import { t } from '../lib/i18n';
import { settings } from '../data/settings';
import type { Language } from '../data/locales';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  lang: Language;
  currentUrl: string;
}

interface LinkSection {
  kind: 'links';
  heading: string | null;
  links: NavLink[];
}

interface BookmarkSection {
  kind: 'bookmarks';
}

type Section = LinkSection | BookmarkSection;

const { lang, currentUrl } = Astro.props;
const { project: projectLinks, book, position } = await combinedNav(lang, currentUrl);

// Project (Start) and book (Contents … Glossary) render as one continuous
// list so there is no gap between Start and Contents.
const mainLinks: NavLink[] =
  position === 'before' ? [...projectLinks, ...book] : [...book, ...projectLinks];
const mainSection: LinkSection = { kind: 'links', heading: null, links: mainLinks };
const bookmarkSection: BookmarkSection = { kind: 'bookmarks' };

const sections: Section[] = [mainSection];
// The bookmark list always sits directly after the main section.
if (settings.web.bookmarks.enabled) {
  sections.splice(sections.indexOf(mainSection) + 1, 0, bookmarkSection);
}

const bookmarkHeading = t(lang, 'bookmarks.bookmarks', 'Bookmarks');
const deleteLabel = t(lang, 'bookmarks.delete-bookmark', 'Delete');
---
<div class="drawer" data-drawer role="dialog" aria-modal="true" aria-label={t(lang, 'nav.menu', 'Menu')} tabindex="-1" hidden>
  <div class="drawer-inner">
    {sections.map(
      (section) =>
        section.kind === 'bookmarks' ? (
          <section class="nav-section" data-bookmark-nav hidden>
            <h2>{bookmarkHeading}</h2>
            <ul
              class="nav-list bookmark-list"
              data-bookmark-list
              data-lang={lang}
              data-delete-label={deleteLabel}
            />
          </section>
        ) : (
          section.links.length > 0 && (
            <section class="nav-section">
              {section.heading && <h2>{section.heading}</h2>}
              <ul class="nav-list">
                {section.links.map((link) => (
                  <li>
                    <a href={link.url} aria-current={link.current ? 'page' : undefined}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        ),
    )}
  </div>
</div>
<div class="drawer-backdrop" data-drawer-backdrop hidden></div>
<button type="button" class="menu-toggle drawer-toggle-float" data-drawer-toggle aria-expanded="false" aria-label={t(lang, 'input.close', 'Close')}>
  <span class="menu-icon"><Icon name="menu" /></span>
  <span class="menu-icon menu-icon--close"><Icon name="x" /></span>
  <span class="menu-label">{t(lang, 'input.close', 'Close')}</span>
</button>
<ThemeToggle lang={lang} float />
