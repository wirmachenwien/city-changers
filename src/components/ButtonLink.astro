---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  href: string;
  label?: string;
  iconBefore?: IconName;
  iconAfter?: IconName;
  download?: boolean;
}
const { href, label, iconBefore, iconAfter, download } = Astro.props;
---
<a class="button-link" href={href} download={download}><span class="button-link__content">{iconBefore && <Icon name={iconBefore} />}{label ?? <slot />}{iconAfter && <Icon name={iconAfter} />}</span></a>
