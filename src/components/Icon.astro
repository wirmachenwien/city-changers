---
import Search from '@lucide/astro/icons/search';
import Globe from '@lucide/astro/icons/globe';
import Menu from '@lucide/astro/icons/menu';
import LinkIcon from '@lucide/astro/icons/link';
import Mail from '@lucide/astro/icons/mail';
import Bookmark from '@lucide/astro/icons/bookmark';
import Download from '@lucide/astro/icons/download';
import Check from '@lucide/astro/icons/check';
import Minus from '@lucide/astro/icons/minus';
import ChevronDown from '@lucide/astro/icons/chevron-down';
import Copy from '@lucide/astro/icons/copy';
import Undo2 from '@lucide/astro/icons/undo-2';
import User from '@lucide/astro/icons/user';
import UsersRound from '@lucide/astro/icons/users-round';
import Pencil from '@lucide/astro/icons/pencil';
import ExternalLink from '@lucide/astro/icons/external-link';
import Send from '@lucide/astro/icons/send';
import MessageCircle from '@lucide/astro/icons/message-circle';
import Share2 from '@lucide/astro/icons/share-2';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import Monitor from '@lucide/astro/icons/monitor';
import X from '@lucide/astro/icons/x';
import MapPin from '@lucide/astro/icons/map-pin';
import Target from '@lucide/astro/icons/target';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Handshake from '@lucide/astro/icons/handshake';
import MessageSquareText from '@lucide/astro/icons/message-square-text';
import Landmark from '@lucide/astro/icons/landmark';
import ChartNoAxesColumn from '@lucide/astro/icons/chart-no-axes-column';
import CalendarCheck from '@lucide/astro/icons/calendar-check';
import ListChecks from '@lucide/astro/icons/list-checks';

export type IconName =
  | 'search'
  | 'globe'
  | 'menu'
  | 'link'
  | 'mail'
  | 'bookmark'
  | 'download'
  | 'check'
  | 'minus'
  | 'chevron'
  | 'copy'
  | 'back'
  | 'person'
  | 'group'
  | 'pencil'
  | 'bluesky'
  | 'facebook'
  | 'linkedin'
  | 'reddit'
  | 'x'
  | 'whatsapp'
  | 'sun'
  | 'moon'
  | 'system'
  | 'location'
  | 'target'
  | 'solution'
  | 'allies'
  | 'narrative'
  | 'politics'
  | 'evidence'
  | 'steps'
  | 'priority';

interface Props {
  name: IconName;
}

const { name } = Astro.props;
const icons = {
  search: Search,
  globe: Globe,
  menu: Menu,
  link: LinkIcon,
  mail: Mail,
  bookmark: Bookmark,
  download: Download,
  check: Check,
  minus: Minus,
  chevron: ChevronDown,
  copy: Copy,
  back: Undo2,
  person: User,
  group: UsersRound,
  pencil: Pencil,
  bluesky: Send,
  facebook: Share2,
  linkedin: ExternalLink,
  reddit: MessageCircle,
  x: X,
  whatsapp: MessageCircle,
  sun: Sun,
  moon: Moon,
  system: Monitor,
  location: MapPin,
  target: Target,
  solution: Lightbulb,
  allies: Handshake,
  narrative: MessageSquareText,
  politics: Landmark,
  evidence: ChartNoAxesColumn,
  steps: CalendarCheck,
  priority: ListChecks,
} satisfies Record<IconName, unknown>;

const Component = icons[name];
---
<Component class="icon" aria-hidden="true" focusable="false" />
