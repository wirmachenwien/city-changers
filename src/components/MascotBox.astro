---
import mascots from '../data/mascots.json';
import type { Language } from '../data/locales';
import { smartQuotes } from '../lib/smart-quotes';
import MascotPreview from './MascotPreview.astro';

interface Props {
  title?: string;
  pose?: keyof typeof mascots;
  animated?: boolean;
  treatment?: 'ink' | 'linen';
  lang?: Language;
}

const { title, pose = 'think', animated = false, treatment = 'ink', lang = 'en' } = Astro.props;
---
<aside class="mascot-box" data-pose={pose}>
  <div class="mascot-box__visual">
    <MascotPreview {pose} {animated} {treatment} {lang} />
  </div>
  <div class="mascot-box__bubble">
    {title && <p class="mascot-box__title"><strong>{smartQuotes(title, lang)}</strong></p>}
    <div class="mascot-box__body"><slot /></div>
  </div>
</aside>

<style>
  .mascot-box {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    margin-block: 1.75rem;
    break-inside: avoid;
  }
  .mascot-box__visual { min-width: 0; }
  .mascot-box__bubble {
    position: relative;
    min-width: 0;
    padding: 1.5rem;
    min-height: 7rem;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .mascot-box__title { margin: 0 0 .5rem; font-family: var(--font-ui); line-height: 1.35; }
  .mascot-box__body :global(> :first-child) { margin-block-start: 0; }
  .mascot-box__body :global(> :last-child) { margin-block-end: 0; }
  @media (max-width: 30rem) {
    .mascot-box { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
    .mascot-box__visual { width: 7rem; }
  }
  @media print {
    .mascot-box { grid-template-columns: 22mm minmax(0, 1fr); gap: 4mm; }
    .mascot-box__visual { width: auto; }
    .mascot-box__bubble { background: transparent; color: var(--ink); border-color: var(--line); }
  }
</style>
