---
 // CC BY licence badge: official Creative Commons 88x31 button
 // (src/assets/site/cc-by.svg) linking to the licence deed.
import ccBy from '../assets/site/cc-by.svg?url';

interface Props {
  href?: string;
}

const { href = 'https://creativecommons.org/licenses/by/4.0/' } = Astro.props;
---
<a class="cc-badge" href={href} rel="license">
  <img src={ccBy} alt="CC BY 4.0" title="CC BY 4.0" width="88" height="31" loading="lazy" decoding="async" />
</a>
