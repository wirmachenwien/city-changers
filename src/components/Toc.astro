---
// Book table of contents, ordered by the web product definition
// (print-only front matter such as cover/title is excluded).
import { bookToc } from '../data/book-toc';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const entries = await bookToc(lang);
---
<ol class="contents-list">
  {entries.map((entry) => (
    <li>
      <a href={entry.url} class={entry.class}>{entry.label}</a>
    </li>
  ))}
</ol>
