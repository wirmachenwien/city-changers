---
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  title?: string;
  body?: string;
  lang?: Language;
  tone?: 'default' | 'warm';
}
const { title, body, lang, tone = 'default' } = Astro.props;
// Prop-supplied text bypasses the markdown pipeline, so quotes are localised here
// to match the hast-transformed prose (only when lang is known).
const displayTitle = title && lang ? smartQuotes(title, lang) : title;
const displayBody = body && lang ? smartQuotes(body, lang) : body;
---
<aside class="feature-box" data-tone={tone}>
  {displayTitle && <p class="feature-box__title"><strong>{displayTitle}</strong></p>}
  {displayBody ? <p>{displayBody}</p> : <slot />}
</aside>
