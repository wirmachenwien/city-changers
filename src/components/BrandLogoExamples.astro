---
import BrandLogo from './BrandLogo.astro';
import { withBase } from '../lib/site';
const logoUrl = (file: string) => withBase(`/brand-assets/files/01-logos/${file}`);
---
<div class="showcase-demo"><BrandLogo label="City Changers logo lockup" /> <BrandLogo variant="symbol" label="Green Fix symbol" /></div>
<div class="logo-grid">
  {[
    { file: 'logo-lockup.svg', label: 'Lockup on light backgrounds', dark: false },
    { file: 'logo-lockup-dark.svg', label: 'Lockup on dark backgrounds', dark: true },
    { file: 'logo.svg', label: 'Symbol on light backgrounds', dark: false },
    { file: 'logo-dark.svg', label: 'Symbol on dark backgrounds', dark: true },
  ].map(({ file, label, dark }) => (
    <figure><div class:list={['logo-preview', { 'logo-preview--dark': dark }]}><img src={logoUrl(file)} alt={label} width="320" height="120" /></div><figcaption><a href={logoUrl(file)} download>{label} (SVG)</a></figcaption></figure>
  ))}
</div>
<style>
  .logo-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); margin-block-end: 2rem; }
  .logo-grid figure { margin: 0; min-width: 0; }
  .logo-preview { background: var(--art-paper); border-radius: .5rem; padding: 1rem; }
  .logo-preview--dark { background: var(--art-dark); }
  .logo-preview img { width: 100%; height: 120px; object-fit: contain; }
</style>
