---
// Visual shell only: callers own labels, navigation and no-JS fallbacks.
import Icon from './Icon.astro';

interface Props {
  id: string;
  options: { label: string; href: string; selected?: boolean }[];
}

const { id, options } = Astro.props;
const selected = options.find(option => option.selected) ?? options[0];
---
<span class="drawn-select">
  <select id={id} data-select>
    {options.map(option => (
      <option value={option.href} selected={option.selected || undefined}>{option.label}</option>
    ))}
  </select>
  <span class="drawn-select__value" data-select-value aria-hidden="true">{selected?.label ?? ''}</span>
  <span class="drawn-select__chevron" aria-hidden="true"><Icon name="chevron-right" /></span>
</span>
