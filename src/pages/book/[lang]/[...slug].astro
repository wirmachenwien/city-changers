---
// Non-default language books (/book/de/01-wozu-diese-toolbox.html, ...).
// URL slugs are derived from the MDX frontmatter title (see
// src/lib/chapter-slug.ts); the catalogue file stays the identity for
// cross-references and pagination. The contents page is virtual (no MDX
// body); its label comes from nav.json. The bare landing (/book/<lang>/)
// redirects to the contents page since the print-only cover/title sheets
// have no web version.
import { getCollection } from 'astro:content';
import BookLayout from '../../../layouts/BookLayout.astro';
import MdxContent from '../../../components/MdxContent.astro';
import Redirect from '../../../components/Redirect.astro';
import { bookToc } from '../../../data/book-toc';
import { contentsLabel } from '../../../data/nav';
import { bookUrl } from '../../../lib/site';
import { defaultLang, languages } from '../../../../handbook.config.ts';
import type { Language } from '../../../data/locales';

export async function getStaticPaths() {
  const perLanguage = await Promise.all(
    languages
      .filter((lang) => lang !== defaultLang)
      .map(async (lang) => {
        const toc = await bookToc(lang);
        return [
          ...toc.map((entry) => ({ params: { lang, slug: entry.slug } })),
          { params: { lang, slug: undefined } },
        ];
      }),
  );
  return perLanguage.flat();
}

const language = Astro.params.lang as Language;
const { slug } = Astro.params;
const file = slug ?? 'index';
const toc = await bookToc(language);
const chapter = file === 'index' ? undefined : toc.find((entry) => entry.slug === slug);
if (!chapter && file !== 'index') {
  throw new Error(`Unknown ${language} book slug: ${slug}`);
}
const entries = await getCollection('book');
const entry = chapter && chapter.file !== 'contents'
  ? entries.find((item) => item.id === `${language}/${chapter.file}`)
  : undefined;
if (chapter && chapter.file !== 'contents' && !entry) {
  throw new Error(`Missing ${language} chapter: ${chapter.file}`);
}
const title = chapter?.label ?? contentsLabel(language);
const url = file === 'index' ? bookUrl(language, 'contents') : (chapter?.url ?? bookUrl(language, file));
---
{file === 'index' ? (
  <Redirect
    lang={language}
    kind="book"
    file="index"
    target={bookUrl(language, 'contents')}
    title={contentsLabel(language)}
  />
) : (
  <BookLayout
    lang={language}
    file={chapter?.file ?? file}
    title={title}
    layout={entry?.data.template ?? 'section'}
    currentUrl={url}
  >
    {entry && <MdxContent entry={entry} />}
  </BookLayout>
)}
