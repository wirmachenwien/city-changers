---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MdxContent from '../../components/MdxContent.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Prose from '../../components/Prose.astro';

const guide = await getEntry('brand', 'brand-guide');
if (!guide) throw new Error('Missing brand guide');
---
<BaseLayout lang={guide.data.lang} title={guide.data.title} kind="page" file="index" currentUrl="/brand" noindex hreflang={false} sidebarToc>
  <ReadingProgress />
  <Prose lang={guide.data.lang} class="brand-guide" externalLinks={false}>
    <MdxContent entry={guide} />
  </Prose>
</BaseLayout>
<script>
  import { initBrandToc } from '../../scripts/brand-toc';
  initBrandToc();
</script>
