---
import { readFileSync } from 'node:fs';
import { createMarkdownProcessor } from '@astrojs/markdown-remark';
import guideSource from '../../../design/brand-guide.md?raw';
import colorReference from '../../../design/colors-reference.md?raw';
import PreviewLayout from '../../layouts/PreviewLayout.astro';
import { withBase } from '../../lib/site';
import MascotPreview from '../../components/MascotPreview.astro';
import mascots from '../../data/mascots.json';

type Asset = { file: string; title: string; bytes: number };
const assets: Asset[] = JSON.parse(readFileSync(new URL('../../../public/brand-assets/catalog.json', import.meta.url), 'utf8'));
const groups = [...new Set(assets.map((asset) => asset.title))];
const assetUrl = (file: string) => withBase(`/brand-assets/files/${file.split('/').map(encodeURIComponent).join('/')}`);
const identitySource = guideSource.split(/^## Identity\s*$/m)[1]?.split(/^## /m)[0]?.trim();
if (!identitySource) throw new Error('Brand guide is missing its Identity section');
const markdown = await createMarkdownProcessor();
const { code: identityHtml } = await markdown.render(identitySource);
const { code: colorReferenceHtml } = await markdown.render(colorReference.replace(/^(#{1,2}) /gm, '###$1 '));
const artworkSource = guideSource.split(/^### Protected artwork colors\s*$/m)[1]?.split(/^## Type\s*$/m)[0]?.trim() ?? '';
const { code: artworkHtml } = await markdown.render(artworkSource);
const colours = [...guideSource.matchAll(/^(.+?)\s+(#[0-9A-F]{6})\s+(.+)$/gm)];
function lottiePreview(file: string) {
  const match = file.match(/\/green-fix-([a-z]+)-(ink|linen)\.json$/);
  if (!match || !Object.hasOwn(mascots, match[1])) return undefined;
  return { pose: match[1] as keyof typeof mascots, treatment: match[2] as 'ink' | 'linen' };
}
---
<PreviewLayout lang="en" title="Brand guide" path="/preview/brand-guide.html">
  <h1>City Changers — brand guide</h1>
  <h2>Identity</h2>
  <div set:html={identityHtml} />
  <h2>Brand examples</h2>
  <h3>Colour reference</h3>
  <p>Three UI color families—green, amber and red—plus neutrals. Supporting shades are derived from this compact palette; artwork colors stay protected.</p>
  <ul class="asset-grid">
    {colours.map(([, name, hex, description]) => (
      <li>
        <span class="swatch" style={{ backgroundColor: hex }} aria-hidden="true"></span>
        <strong>{name.trim()}</strong> <code>{hex}</code>
        <small>{description}</small>
      </li>
    ))}
  </ul>
  <h4>Protected artwork colors</h4>
  <div set:html={artworkHtml} />
  <details class="color-reference">
    <summary>Technical color reference — themes, recipes and accessibility</summary>
    <div set:html={colorReferenceHtml} />
    <p><a href={assetUrl('COLOR-REFERENCE.md')} download>Download the technical color reference</a></p>
    <p><a href={assetUrl('COLORS.json')} download>Download the color registry (JSON)</a></p>
  </details>
  <h3>Typography</h3>
  <p class="type-headline">Fraunces — Small steps. Better streets.</p>
  <p class="type-caption">Clarity City — Practical tools for community action.</p>
  <p class="type-editorial">Newsreader — Longer stories from the neighbourhood.</p>
  <h2>Asset library</h2>
  <p>These downloads and the handoff kit come from the same asset manifest. Generated animations still need visual review before publication.</p>
  <p><a href={withBase('/brand-assets/city-changers-brand-kit.zip')} download>Download the complete brand kit (ZIP)</a></p>
  <p><a href={assetUrl('BRAND-GUIDE.md')} download>Download this guide (Markdown)</a></p>
  {groups.map((title) => (
    <section aria-label={title}>
      <h3>{title}</h3>
      {title === 'Lottie animations' && <p>Each preview plays once whenever it enters or re-enters the viewport. Hover, click or use Enter or Space to replay. Think holds its raised-hand idea pose. Reduced-motion and print views show stills.</p>}
      <ul class="asset-grid">
        {assets.filter((asset) => asset.title === title).map((asset) => {
          const preview = lottiePreview(asset.file);
          return (
          <li>
            {preview && (
              <div class:list={['asset-preview', 'lottie-preview', { 'asset-preview-dark': preview.treatment === 'linen' }]}>
                <div class="lottie-preview__artwork">
                  <MascotPreview pose={preview.pose} treatment={preview.treatment} />
                </div>
              </div>
            )}
            {/\.(png|svg|jpg)$/i.test(asset.file) && (
              <div class:list={['asset-preview', { 'asset-preview-dark': /linen|dark/.test(asset.file) }]}>
                <img src={assetUrl(asset.file)} alt="" loading="lazy" width="240" height="180" />
              </div>
            )}
            <a href={assetUrl(asset.file)} download>{asset.file.split('/').slice(-2).join('/')}</a>
            <small>{asset.bytes < 1024 * 1024 ? `${Math.ceil(asset.bytes / 1024)} KB` : `${(asset.bytes / 1024 / 1024).toFixed(1)} MB`}</small>
          </li>
          );
        })}
      </ul>
    </section>
  ))}
</PreviewLayout>

<style>
  .asset-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; list-style: none; padding: 0; }
  .asset-grid li { border: 1px solid currentColor; border-radius: .5rem; padding: .75rem; min-width: 0; }
  .asset-grid a { display: flex; align-items: center; min-height: 44px; overflow-wrap: anywhere; }
  .asset-grid small { display: block; }
  .asset-preview { background: var(--art-paper); border-radius: .25rem; padding: .75rem; }
  .asset-preview-dark { background: var(--art-dark); }
  .asset-preview img { width: 100%; height: 180px; object-fit: contain; }
  .lottie-preview { display: grid; place-items: center; }
  .lottie-preview__artwork { width: min(100%, 180px); }
  .swatch { display: block; height: 3rem; border: 1px solid currentColor; margin-block-end: .75rem; }
  .type-headline { font-family: 'Fraunces', Georgia, serif; font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 700; }
  .type-caption { font-family: 'Clarity City', sans-serif; }
  .type-editorial { font-family: 'Newsreader', Georgia, serif; font-size: 1.25rem; }
  .color-reference { margin-block: 1.5rem; }
  .color-reference summary { cursor: pointer; font-weight: 700; }
  .color-reference > div { overflow-x: auto; }
</style>
