---
// Base document shell: head/SEO, masthead, nav drawer, sidebar, footer,
// and the progressive-enhancement client bundle.
import '../styles/global.css';
import { settings } from '../data/settings';
import { projectText, t, htmlDir } from '../lib/i18n';
import { canonical, withBase } from '../lib/site';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';
import Masthead from '../components/Masthead.astro';
import NavDrawer from '../components/NavDrawer.astro';
import SideNav from '../components/SideNav.astro';
import Footer from '../components/Footer.astro';
import AlternateLinks from '../components/AlternateLinks.astro';
import Plausible from '../components/Plausible.astro';
import { themeColorLight, themeColorDark } from '../../handbook.config';
import ogImage from '../assets/site/og-image.png';

interface Props {
  lang: Language;
  title: string;
  kind: 'page' | 'book';
  file: string;
  currentUrl: string;
  noindex?: boolean;
  hreflang?: boolean;
}

const { lang, title, kind, file, currentUrl, noindex = false, hreflang = true } = Astro.props;
// Frontmatter strings bypass the markdown pipeline, so quotes are
// localised here to match the rehype-transformed prose.
const displayTitle = smartQuotes(title, lang);
const text = projectText(lang);
const projectName = smartQuotes(text.name, lang);
const fullTitle = `${displayTitle}${settings.web.titleDivider}${projectName}`;
const metaDescription = smartQuotes(text.description, lang);
const hideFromIndex = noindex || !settings.web.indexing;
---
<!doctype html>
<html lang={lang} dir={htmlDir(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={themeColorLight} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={themeColorDark} />
    <script is:inline>
      try {
        var m = localStorage.getItem('wmw-theme');
        if (m === 'light' || m === 'dark') document.documentElement.dataset.theme = m;
      } catch (e) {}
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {hideFromIndex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical(currentUrl)} />
    {hreflang && <AlternateLinks lang={lang} kind={kind} file={file} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical(currentUrl)} />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content={canonical(ogImage.src)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={projectName} />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <link rel="sitemap" href={withBase('/sitemap.xml')} type="application/xml" title="Sitemap" />
    <Plausible noindex={hideFromIndex} />
  </head>
  <body
    data-pagefind-ignore={noindex ? '' : undefined}
    data-collapsible-sections={settings.web.collapsibleSections}
    data-search-param={settings.web.search.param}
  >
    <a class="skip-link" href="#main">{t(lang, 'nav.toc', 'Contents')}</a>
    <Masthead lang={lang} kind={kind} file={file} />
    <NavDrawer lang={lang} currentUrl={currentUrl} />
    <div class="shell">
      <div class="main-grid">
        <SideNav lang={lang} currentUrl={currentUrl} />
        <main id="main" class="article" data-pagefind-body>
          <slot />
        </main>
      </div>
    </div>
    <Footer lang={lang} kind={kind} file={file} />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
