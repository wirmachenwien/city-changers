---
// Book page layout: breadcrumbs, reading aids, share links, pagination.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Pagination from '../components/Pagination.astro';
import Share from '../components/Share.astro';
import BookmarkAdd from '../components/BookmarkAdd.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import ContentsPage from '../components/ContentsPage.astro';
import { settings } from '../data/settings';
import { bookCrumbs } from '../lib/nav';
import { paginationNeighbours } from '../data/works';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
  file: string;
  title: string;
  layout: 'chapter' | 'section';
  currentUrl: string;
}

const { lang, file, title, layout, currentUrl } = Astro.props;
// The frontmatter title bypasses the markdown pipeline, so quotes are
// localised once here; crumbs, share links and sheets reuse it.
const displayTitle = smartQuotes(title, lang);
const crumbs = bookCrumbs(lang, file, displayTitle);
const isChapter = layout === 'chapter';
// The Steckbrief worksheet (07) is an interactive form, not prose:
// bookmark pins cannot anchor to its dynamic fields and heading
// permalinks serve no section navigation, so both stay off.
const isWorksheet = file === '07';
const neighbours = paginationNeighbours(lang, 'book', file);
---
<BaseLayout
  lang={lang}
  title={title}
  kind="book"
  file={file}
  currentUrl={currentUrl}
>
  <ReadingProgress />
  {isChapter ? (
    <Breadcrumbs items={crumbs} lang={lang} />
  ) : (
    // Sections and the virtual contents page have no navigation trail, but
    // keep the exact vertical rhythm of chapters: a hidden duplicate of the
    // breadcrumbs reserves precisely their height (including line wraps).
    <div class="crumbs-spacer" aria-hidden="true">
      <Breadcrumbs items={crumbs} lang={lang} />
    </div>
  )}
  {file === 'contents' && <ContentsPage lang={lang} title={displayTitle} />}
  {isChapter && !isWorksheet && <BookmarkAdd lang={lang} />}
  <div class="prose" data-prose data-glossary-terms data-no-anchors={isWorksheet ? '' : undefined}>
    <slot />
  </div>
  {isChapter && <Share lang={lang} url={currentUrl} title={displayTitle} />}
  {neighbours && settings.web.pagination && <Pagination lang={lang} prev={neighbours.prev} next={neighbours.next} />}
</BaseLayout>
