---
// Project page layout: home, search.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import OpenerImage from '../components/OpenerImage.astro';
import LastVisit from '../components/LastVisit.astro';
import Pagination from '../components/Pagination.astro';
import { settings } from '../data/settings';
import { paginationNeighbours } from '../data/book-toc';
import { pageCrumbs } from '../lib/nav';
import { smartQuotes } from '../lib/smart-quotes';
import type { Language } from '../data/locales';

interface Props {
  lang: Language;
  file: string;
  title: string;
  layout: 'home' | 'page' | 'search';
  currentUrl: string;
  openerImage?: string;
  openerImageAlt?: string;
  openerImageCaption?: string;
}

const { lang, file, title, layout, currentUrl, openerImage, openerImageAlt, openerImageCaption } = Astro.props;
// The frontmatter title bypasses the markdown pipeline, so quotes are
// localised once here and reused below.
const displayTitle = smartQuotes(title, lang);
const crumbs = pageCrumbs(lang, displayTitle);
const isHome = layout === 'home';
const neighbours = await paginationNeighbours(lang, 'page', file);
---
<BaseLayout
  lang={lang}
  title={title}
  kind="page"
  file={file}
  currentUrl={currentUrl}
>
  {!isHome && <Breadcrumbs items={crumbs} lang={lang} />}
  {isHome && openerImage && <OpenerImage file={openerImage} alt={openerImageAlt ?? ''} caption={openerImageCaption} lang={lang} />}
  <div class="prose" data-prose>
    <slot />
  </div>
  {isHome && <LastVisit lang={lang} />}
  {neighbours && settings.web.pagination && <Pagination lang={lang} prev={neighbours.prev} next={neighbours.next} />}
</BaseLayout>
