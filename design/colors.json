{
  "version": 1,
  "description": "Three UI color families plus neutrals. Supporting shades are recipes, not additional palette choices. Artwork is protected and never regenerated by color tooling.",
  "families": {
    "neutral": { "paper": "#FDFCF9", "dark": "#161511", "ink": "#1D1A16", "cream": "#F2EDE3", "white": "#FFFFFF", "black": "#000000" },
    "green": { "light": "#0C6B3C", "dark": "#4CC38A" },
    "amber": { "light": "#8A4B00", "dark": "#E8A33D", "highlight": "#FFE08A" },
    "red": { "light": "#A31F1F", "dark": "#FF8A7A" }
  },
  "palette": [
    { "name": "Paper", "ref": "neutral.paper", "use": "Primary light background." },
    { "name": "Ink", "ref": "neutral.ink", "use": "Primary light-theme text; distinct from mascot ink." },
    { "name": "Website green", "ref": "green.light", "use": "Primary accent, links and actions." },
    { "name": "Warm brown", "ref": "amber.light", "use": "Supporting accent for warm FeatureBox highlights." },
    { "name": "Error red", "ref": "red.light", "use": "Errors only; always accompanied by text, not color alone." }
  ],
  "artwork": {
    "mascot-green": { "value": "#176B43", "use": "Fixed mascot body color; do not recolor.", "sources": ["src/assets/site/logo.svg", "src/assets/site/logo-dark.svg", "src/assets/mascot/static/ink/think.svg"] },
    "mascot-ink": { "value": "#20221C", "use": "Fixed outlines and boots in the Ink treatment.", "sources": ["src/assets/site/logo.svg", "src/assets/site/logo-dark.svg"] },
    "mascot-yellow": { "value": "#FFD84F", "use": "Fixed mascot detail and idea-ray color.", "sources": ["src/assets/site/logo.svg", "src/assets/site/logo-dark.svg"] },
    "idea-highlight": { "value": "#FFF0A8", "use": "Fixed pale highlight in the Think pose.", "sources": ["src/assets/mascot/static/ink/think.svg", "src/assets/mascot/static/linen/think.svg"] },
    "linen": { "value": "#CBBF9F", "use": "Fixed pale outlines and boots in the Linen treatment.", "sources": ["src/assets/site/logo-dark.svg", "src/assets/mascot/static/linen/think.svg"] },
    "cream-lettering": { "ref": "neutral.cream", "use": "Logo lettering on dark backgrounds.", "sources": ["src/assets/site/logo-lockup-dark.svg"] },
    "presentation-neutral": { "value": "#EFEEE5", "use": "Frozen presentation-board background in existing artwork; not a UI color choice.", "sources": ["design/motion/src/Scenes.tsx", "design/scripts/build-mascot-kit.py"] }
  },
  "tokens": {
    "paper": { "light": "neutral.paper", "dark": "neutral.dark", "use": "Page background." },
    "ink": { "light": "neutral.ink", "dark": "neutral.cream", "use": "Primary text." },
    "ink-soft": { "light": { "mix": ["neutral.ink", "neutral.paper"], "weight": 0.8 }, "dark": { "mix": ["neutral.cream", "neutral.dark"], "weight": 0.78 }, "use": "Secondary text and captions." },
    "accent": { "light": "green.light", "dark": "green.dark", "use": "Links, actions and positive emphasis." },
    "accent-ink": { "light": "neutral.white", "dark": "neutral.dark", "use": "Text on the green accent." },
    "accent-soft": { "light": { "mix": ["green.light", "neutral.paper"], "weight": 0.1 }, "dark": { "mix": ["green.dark", "neutral.dark"], "weight": 0.14 }, "use": "Subtle green emphasis." },
    "line": { "light": { "mix": ["neutral.ink", "neutral.paper"], "weight": 0.16 }, "dark": { "mix": ["neutral.cream", "neutral.dark"], "weight": 0.18 }, "use": "Decorative separators, not sole control boundaries." },
    "control-border": { "light": { "mix": ["neutral.ink", "neutral.paper"], "weight": 0.55 }, "dark": { "mix": ["neutral.cream", "neutral.dark"], "weight": 0.45 }, "use": "Visible boundaries for selects and other outlined controls." },
    "panel": { "light": { "mix": ["amber.light", "neutral.paper"], "weight": 0.06 }, "dark": { "mix": ["neutral.cream", "neutral.dark"], "weight": 0.06 }, "use": "Neutral cards and FeatureBoxes." },
    "warn": { "light": "amber.light", "dark": "amber.dark", "use": "Warm supporting emphasis; not automatically a warning." },
    "warn-soft": { "light": { "mix": ["amber.highlight", "neutral.paper"], "weight": 0.22 }, "dark": { "mix": ["amber.dark", "neutral.dark"], "weight": 0.14 }, "use": "Background of warm FeatureBoxes." },
    "error": { "light": "red.light", "dark": "red.dark", "use": "Error text, paired with a written message." },
    "mark": { "light": "amber.highlight", "dark": { "mix": ["amber.dark", "neutral.dark"], "weight": 0.3 }, "use": "Search-result highlighting." },
    "mark-ink": { "light": "neutral.ink", "dark": "neutral.cream", "use": "Text on search highlighting." },
    "focus": { "light": "green.light", "dark": "green.dark", "use": "Focus rings on ordinary UI surfaces." },
    "popup-link": { "light": { "mix": ["green.light", "neutral.paper"], "weight": 0.6 }, "dark": { "mix": ["green.dark", "neutral.dark"], "weight": 0.6 }, "use": "Icons and focus rings on inverse popup surfaces." }
  },
  "utilities": {
    "white": "neutral.white",
    "black": "neutral.black",
    "art-paper": "neutral.paper",
    "art-dark": "neutral.dark",
    "scrim": { "alpha": "neutral.black", "opacity": 0.45 },
    "video-scrim": { "alpha": "neutral.black", "opacity": 0.65 },
    "shadow-soft": { "alpha": "neutral.black", "opacity": 0.16 },
    "shadow": { "alpha": "neutral.black", "opacity": 0.2 },
    "shadow-strong": { "alpha": "neutral.black", "opacity": 0.3 },
    "cover-shadow-deep": { "alpha": "neutral.black", "opacity": 0.82 },
    "cover-shadow-mid": { "alpha": "neutral.black", "opacity": 0.45 },
    "cover-shadow-faint": { "alpha": "neutral.black", "opacity": 0.05 },
    "cover-shadow-edge": { "alpha": "neutral.black", "opacity": 0.25 }
  },
  "print": {
    "description": "White paper and monochrome secondary text/separators conserve ink. Body text, links and FeatureBox colors use registered tokens, not reader defaults. Exporters resolve tokens to literal CSS for older EPUB readers. Reading apps may apply their own user-selected theme overrides.",
    "overrides": {
      "paper": "neutral.white",
      "ink-soft": { "mix": ["neutral.ink", "neutral.white"], "weight": 0.8 },
      "line": { "mix": ["neutral.ink", "neutral.white"], "weight": 0.45 }
    }
  },
  "contrast": {
    "text": [
      ["ink", "paper"], ["ink", "panel"], ["ink", "accent-soft"], ["ink", "warn-soft"],
      ["ink-soft", "paper"], ["ink-soft", "panel"],
      ["accent", "paper"], ["accent", "panel"], ["accent", "accent-soft"], ["accent", "warn-soft"],
      ["accent-ink", "accent"], ["error", "paper"], ["error", "panel"],
      ["warn", "warn-soft"], ["mark-ink", "mark"], ["paper", "ink"]
    ],
    "graphics": [["focus", "paper"], ["focus", "panel"], ["popup-link", "ink"], ["control-border", "paper"], ["control-border", "panel"]],
    "qr": [["black", "white"]]
  },
  "audit": {
    "scan": ["."],
    "exceptions": [
      { "path": "src/assets", "reason": "Supplied and generated artwork, photos, partner marks and fonts are not UI palette choices." },
      { "path": "design/colors.json", "reason": "Editable source of truth; base colors and recipes are validated before generation." },
      { "path": "src/data/colors.generated.json", "reason": "Generated registry output; exact freshness is checked." },
      { "path": "src/styles/colors.generated.css", "reason": "Generated registry output; exact freshness is checked." },
      { "path": "scripts/lib/colors.mjs", "reason": "Color serialization and audit implementation, tested independently." },
      { "path": "scripts/tests", "reason": "Tests contain deliberate literal fixtures and expected values." },
      { "path": "design/tests", "reason": "Tests contain deliberate artwork-color fixtures and expected values." }
    ],
    "protected": [
      { "path": "design/assets", "reason": "Protected logo masters and mascot sources. Palette changes do not authorize artwork edits." },
      { "path": "design/motion", "reason": "Protected animation sources and dependency tree; do not regenerate videos or Lotties." },
      { "path": "design/scripts/build-brand-assets.py", "reason": "Artwork generator; changing it would invalidate protected generated assets." },
      { "path": "design/scripts/build-mascot-kit.py", "reason": "Artwork generator; its presentation tile neutral is not an interface color." },
      { "path": "public", "reason": "Generated assets and supplied third-party files; website chrome config is independently checked by check:config." }
    ]
  }
}
