{
  "name": "city-changers-mascot-motion",
  "version": "1.0.0",
  "description": "Reusable Green Fix mascot loops and social layouts",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/paths": "4.0.539",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "export:lottie": "node --experimental-strip-types scripts/export-lotties.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "check:motion": "node --experimental-strip-types --test src/motion.test.ts src/parts/parts.test.ts"
  },
  "overrides": {
    "zod": "$zod"
  },
  "allowScripts": {
    "esbuild": false
