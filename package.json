{
  "name": "city-changers",
  "type": "module",
  "version": "3.0.0",
  "description": "Toolbox for City Changers handbook site (Astro, static)",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "npm run colors:check && npm run icons:check && npm run elements:check && npm run design:prepare && astro dev",
    "build": "npm run colors:check && npm run icons:check && npm run elements:check && npm run design:prepare && astro build && npm run build:downloads && node scripts/bin/fix-dist.mjs && npm run build:search",
    "colors:generate": "node scripts/bin/sync-colors.mjs",
    "colors:check": "node scripts/bin/sync-colors.mjs --check",
    "icons:build": "node design/icons/build-icons.mjs",
    "icons:check": "node design/icons/build-icons.mjs --check",
    "elements:build": "node design/elements/build-css-frames.mjs",
    "elements:check": "node design/elements/build-css-frames.mjs --check",
    "design:build": "python3 design/scripts/build-design.py",
    "design:plan": "python3 design/scripts/build-design.py --plan",
    "design:check": "python3 design/scripts/build-design.py --check",
    "design:prepare": "python3 design/scripts/prepare-brand-site.py",
    "build:downloads": "node scripts/bin/build-downloads.mjs",
    "build:pdf": "npm run colors:check && npm run icons:check && python3 scripts/bin/build-pdf.py --all",
    "build:epub": "npm run colors:check && npm run icons:check && python3 scripts/bin/build-epub.py --all",
    "build:search": "pagefind --site dist --root-selector 'main[data-pagefind-body]'",
    "preview": "astro preview",
    "audio:plan": "node scripts/audio/cli.mjs plan",
    "audio:proofread": "node scripts/audio/cli.mjs proofread",
    "audio:preflight": "node --env-file-if-exists=.env scripts/audio/cli.mjs preflight",
    "audio:generate": "node --env-file-if-exists=.env scripts/audio/cli.mjs generate",
    "audio:prepare": "node scripts/audio/cli.mjs prepare",
    "audio:check": "node scripts/audio/check-release.mjs",
    "audio:release": "python3 scripts/audio/publish-release.py",
    "audio:test": "node --test scripts/tests/audio.mjs scripts/tests/audio-player.mjs scripts/tests/audio-publication.mjs scripts/tests/audio-media.mjs scripts/tests/audio-generation.mjs scripts/tests/audio-sentences.mjs scripts/tests/audio-proofread.mjs scripts/tests/audio-pauses.mjs scripts/tests/audio-release.mjs && python3 -m unittest discover -s scripts/tests -p 'test*release*.py'",
    "astro": "astro",
    "sync:config": "node scripts/bin/sync-config.mjs",
    "check:config": "node scripts/bin/sync-config.mjs --check",
    "check:site": "node scripts/bin/check-site.mjs && node --test scripts/tests/handbook-rendered.mjs scripts/tests/brand-release-rendered.mjs",
    "check:glossary": "node scripts/bin/check-glossary.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/markdown-satteri": "^0.4.6",
    "astro": "^7.4.4",
    "github-slugger": "^2.0.0",
    "katex": "^0.19.1",
    "lottie-web": "^5.13.0",
    "qrcode": "^1.5.4",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "^8.1.2",
    "@types/qrcode": "^1.5.6",
    "linkedom": "^0.18.14",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  }
}
